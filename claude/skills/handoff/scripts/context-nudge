#!/usr/bin/env bash
# PostToolUse hook (settings.json, every session): once the main session's context reaches the
# threshold, tell it once per session to finish the step in hand and hand off with the handoff skill;
# a bees orchestrator follows bees reference/handoff.md instead. Sub-agent tool calls (agent_id set)
# are skipped: their own context is bee-context-nudge's. Reads the transcript's last main-chain
# assistant usage; no reading yet means no nudge, and the next tool call retries.
# Its only write is the per-session marker in $TMPDIR, made after the nudge is emitted.
#   HANDOFF_NUDGE_AT  threshold in tokens (default 170000: bees' cheapest handoff point for the
#                     measured startup cost and growth; the safe point after it lands by ~200k)
set -uo pipefail
input="$(cat)"
[ -z "$(jq -r '.agent_id // empty' <<<"$input")" ] || exit 0
sid="$(jq -r '.session_id // empty' <<<"$input")"
transcript="$(jq -r '.transcript_path // empty' <<<"$input")"
[ -n "$sid" ] && [ -f "$transcript" ] || exit 0
marker="${TMPDIR:-/tmp}/handoff-context-nudge-$sid"
[ -e "$marker" ] && exit 0
at="${HANDOFF_NUDGE_AT:-170000}"
ctx="$(tail -n 400 "$transcript" | jq -Rr 'fromjson? | select(.type == "assistant" and (.isSidechain | not)) | .message.usage // empty
  | (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)' 2>/dev/null | tail -1)"
[ -n "$ctx" ] && [ "$ctx" -ge "$at" ] || exit 0
jq -nc --arg k "$((at / 1000))k" '{hookSpecificOutput: {hookEventName: "PostToolUse",
  additionalContext: "Context at \($k): start nothing new, finish the step in hand, then hand the remaining work to a fresh session with the handoff skill. A bees orchestrator follows bees reference/handoff.md \"Checklist\" instead."}}'
touch "$marker"
