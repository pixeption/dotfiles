#!/usr/bin/env bash
# unity-test <filter> [--type name|assembly|category] [--mode editmode|playmode] [--project-path <dir>]
#                     [--deadline <seconds>] [--start-deadline <seconds>] [--result <file.json>] [--no-restart]
# EditMode runs detach (`--detach` + `unity job wait`): the result survives the CLI request timeout, not a domain reload.
# PlayMode cannot detach — entering Play mode drops the request — so it runs --async_tests and polls
# test_status. --result saves the run's result JSON (after the filter check) for a caller to merge;
# --no-restart exits 2 on the start hang instead of restarting the editor, for a caller holding it.
# A filter of several names joined with ; runs one unity-test per name (Pipeline's run_tests matches
# one substring) and reports their union. --no-restart first waits out a pending recompile, so a
# caller holding the editor never runs the assemblies from before its edit.
# Exit 0 all passed, 1 failures / no tests matched / filter mismatch, 2 could not run.
set -uo pipefail
source "$(dirname "$0")/_common.sh"
DIE_CODE=2

FILTER=""; TYPE=testName; MODE=EditMode; PROJECT_ARG="${UNITY_PROJECT_PATH:-.}"; RESULT_FILE=""; RESTART=1
# DEADLINE bounds the whole run and is passed on as run_tests' own timeout: 15 min is far above a
# filtered run, and it must outlast the run or the tool's timeout wedges the exec gate (below).
DEADLINE=900
# A healthy run logs "Run started" within seconds; 2 min allows a busy editor yet ends the silent
# hang long before DEADLINE. UNITY_TEST_START_DEADLINE sets it where no flag reaches (unity-suite's tests).
START_DEADLINE=${UNITY_TEST_START_DEADLINE:-120}
while [[ $# -gt 0 ]]; do case "$1" in
  --start-deadline) START_DEADLINE=$2; shift 2;;
  --type) TYPE=$([[ $2 == name ]] && echo testName || echo "$2"); shift 2;;
  --mode) MODE=$([[ ${2,,} == playmode ]] && echo PlayMode || echo EditMode); shift 2;;
  --project-path) PROJECT_ARG=$2; shift 2;;
  --deadline) DEADLINE=$2; shift 2;;
  --result) RESULT_FILE=$2; shift 2;;
  --no-restart) RESTART=0; shift;;
  -*) die "unknown option $1";;
  *) FILTER=$1; shift;;
esac; done
[[ -n "$FILTER" ]] || die "a test filter is required — an empty one runs the WHOLE suite"

if [[ "$FILTER" == *';'* ]]; then
  PARTS=$(mktemp -d) && trap 'rm -rf "$PARTS"' EXIT || die "cannot create a temp directory"
  IFS=';' read -ra NAMES <<<"$FILTER"
  RC=0
  for i in "${!NAMES[@]}"; do
    echo "${NAMES[$i]}:"
    "$0" "${NAMES[$i]}" --type "$TYPE" --mode "$MODE" --project-path "$PROJECT_ARG" --deadline "$DEADLINE" \
      --start-deadline "$START_DEADLINE" --result "$PARTS/$i.json" $( (( RESTART )) || echo --no-restart )
    rc=$?; (( rc > RC )) && RC=$rc
  done
  python3 - "$RESULT_FILE" "$PARTS"/*.json <<'MERGE' || exit 2
import json, sys
lower = lambda d: {k.lower(): v for k, v in d.items()}
bad = lambda t: (t.get("Status") or t.get("status")) not in ("Passed", "Skipped")
name = lambda t: t.get("FullName") or t.get("fullName")
cases = {}
for path in sys.argv[2:]:
    for t in lower(json.load(open(path))).get("results") or []:
        if name(t) not in cases or not bad(cases[name(t)]): cases[name(t)] = t
count = lambda s: sum((t.get("Status") or t.get("status")) == s for t in cases.values())
passed, skipped = count("Passed"), count("Skipped")
summary = dict(Total=len(cases), Passed=passed, Failed=len(cases) - passed - skipped, Skipped=skipped)
print("all: %(Passed)s/%(Total)s passed, %(Failed)s failed, %(Skipped)s skipped" % summary)
if sys.argv[1]: json.dump(dict(Summary=summary, Results=list(cases.values())), open(sys.argv[1], "w"))
MERGE
  exit "$RC"
fi
PROJECT=$(resolve_project "$PROJECT_ARG") || exit 2
editor_open "$PROJECT" || die "no live editor for $PROJECT — unity-editor up '$PROJECT'"
"$(dirname "$0")/unity-wait" --project-path "$PROJECT" ready 180 >/dev/null \
  || die "editor not ready: editor_status silent for 180s (a stuck command holds the exec gate?) - unity-editor ensure '$PROJECT'"
if (( ! RESTART )); then
  COMPILE=$("$(dirname "$0")/unity-wait" --project-path "$PROJECT" recompile 2>&1) \
    || die "the recompile before the run did not finish clean; no tests ran:
$COMPILE"
fi

PM=$(result_json "$PROJECT" editor_status | field playMode)
[[ "$MODE" == PlayMode || -z "$PM" || "$PM" == stopped ]] \
  || die "editor is in Play Mode (playMode: $PM) — an EditMode run makes no progress; stop it first"

unity command clear_console --project-path "$PROJECT" --format json >/dev/null 2>&1

# The test framework asks to save modified scenes before a run; the editor auto-cancels that
# "Scene(s) Have Been Modified" dialog and the run never starts, holding the exec gate. A dirty
# untitled active scene holds nothing anyone saved, so it is replaced by an empty one; a dirty titled
# scene is the user's work, so it is only named if the run hangs. Prints the first dirty titled
# scene's path, else `untitled` for a dirty untitled active scene, else nothing.
dirty_scene() { result_json "$PROJECT" list_open_scenes | python3 -c '
import sys, json
scenes = json.load(sys.stdin)["scenes"]
titled = [s["path"] for s in scenes if s["isDirty"] and s["path"]]
print(titled[0] if titled else "untitled" if any(s["isDirty"] and s["isActive"] for s in scenes) else "")
' 2>/dev/null; }
DIRTY_SCENE=$(dirty_scene) || die "could not inspect open scenes; no tests ran"
if [[ "$DIRTY_SCENE" == untitled ]]; then
  # One command, so the scene it discards is re-checked at the moment it is discarded; other open
  # scenes stay open.
  unity command eval --project-path "$PROJECT" --format json --code '
if (UnityEditor.EditorApplication.isPlayingOrWillChangePlaymode)
    throw new System.InvalidOperationException("Cannot replace a scene during Play Mode.");
var scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();
if (!scene.IsValid() || !scene.isDirty || !string.IsNullOrEmpty(scene.path))
    throw new System.InvalidOperationException("The active scene changed; refusing to discard it.");
var clean = UnityEditor.SceneManagement.EditorSceneManager.NewScene(
    UnityEditor.SceneManagement.NewSceneSetup.EmptyScene,
    UnityEditor.SceneManagement.NewSceneMode.Additive);
UnityEngine.SceneManagement.SceneManager.SetActiveScene(clean);
if (!UnityEditor.SceneManagement.EditorSceneManager.CloseScene(scene, true))
    throw new System.InvalidOperationException("Could not close the dirty untitled scene.");
return null;
' >/dev/null 2>&1 || die "could not safely replace the dirty untitled active scene"
  DIRTY_SCENE=$(dirty_scene) || die "could not inspect open scenes; no tests ran"
  [[ "$DIRTY_SCENE" == untitled ]] && die "the untitled active scene has unsaved changes and could not be replaced by an empty one;
the test framework's save prompt would cancel the run - discard it in the editor first"
fi

# The tool's own --timeout (after the bare --; before it, --timeout is the CLI's request timeout) is
# load-bearing: its default is 300 s, and when it fires Pipeline 0.7 cancels the collector but never
# completes the command, which then holds the one-command exec gate until the editor restarts.
run_tests() { unity command run_tests --project-path "$PROJECT" --mode "$MODE" --filter "$FILTER" --filter_type "$TYPE" --format json "$@" -- --timeout "$DEADLINE"; }

if [[ "$MODE" == EditMode ]]; then
  log_slice() { tail -c +"$LOG_FROM" "$LOG"; }
  run_started() { log_slice | grep '^\[TestResultCollector\] Run started' >/dev/null; }
  job_state() { unity job status "$JOB" --project-path "$PROJECT" --format json 2>/dev/null | python3 -c '
import sys, json
try: print(json.load(sys.stdin)["data"]["state"])
except Exception: pass'; }
  job_done() { [[ $(job_state) =~ ^(completed|failed|canceled)$ ]]; }
  hung() { [[ $(job_state) == running ]] && log_slice | grep '^\[PipelineTestRunner\] Running [0-9]* tests' >/dev/null && ! run_started; }
  started_or_done() { run_started || job_done; }
  # Pipeline can accept run_tests, log "Running N tests" and never start the TestRunnerApi run: the
  # job stays `running`, holds the one-command exec gate (editor_status times out) and ignores
  # `job cancel`. Nothing will ever arrive, so give up within START_DEADLINE instead of the full DEADLINE.
  start_run() {
    LOG=$(editor_log)
    LOG_FROM=$(( $(wc -c <"$LOG") + 1 ))
    JOB=$(run_tests --detach | python3 -c 'import sys,json; print(json.load(sys.stdin)["data"]["jobId"])') \
      || die "run did not start (editor busy or compiling?)"
    wait_for "$START_DEADLINE" started_or_done 2>/dev/null && return
    unity job cancel "$JOB" --project-path "$PROJECT" --format json >/dev/null 2>&1
    log_slice | grep -F 'Canceling DisplayDialog: Scene(s) Have Been Modified' >/dev/null \
      && die "run_tests job $JOB never started: the test framework's 'Scene(s) Have Been Modified' dialog was
auto-cancelled (${DIRTY_SCENE:-a scene} has unsaved changes), and the cancelled run holds the exec gate.
Save that scene in the editor if it is worth keeping, then: unity-editor ensure '$PROJECT'"
    hung && return 1
    die "run_tests job $JOB: no '[TestResultCollector] Run started' in $LOG and no terminal job state
within ${START_DEADLINE}s; cancellation requested. Not the known hang (job not running with
'Running N tests' logged), so the editor was left alone: check \`unity job status $JOB\` and /api/progress."
  }
  start_run || {
    (( RESTART )) || die "run_tests job $JOB: no '[TestResultCollector] Run started' within ${START_DEADLINE}s
(the known start hang); cancellation requested, editor left alone (--no-restart): unity-editor ensure '$PROJECT'."
    echo "run_tests job $JOB did not start within ${START_DEADLINE}s; restarting the editor once and retrying" >&2
    "$(dirname "$0")/unity-editor" restart "$PROJECT" >&2 || die "unity-editor restart '$PROJECT' failed"
    start_run || die "run_tests job $JOB: no '[TestResultCollector] Run started' in $LOG and no terminal job state
within ${START_DEADLINE}s; cancellation requested. One editor restart did not help."; }
  RESULT=$(unity job wait "$JOB" --project-path "$PROJECT" --timeout "$DEADLINE" --format json \
           | python3 -c 'import sys,json; print(json.dumps(json.load(sys.stdin)["data"]["result"]))') \
    || die "job wait failed for $JOB"
else
  run_tests --async_tests true >/dev/null || die "run did not start"
  LAST=""
  finished() { LAST=$(result_json "$PROJECT" test_status); [[ "$(printf '%s' "$LAST" | field status)" == completed ]]; }
  wait_for "$DEADLINE" finished || exit 2
  RESULT=$LAST
fi

printf '%s' "$RESULT" | python3 -c '
import sys, json
r = json.load(sys.stdin); k = lambda *names: next((r[n] for n in names if n in r), None)
want = f"{sys.argv[1]}: {sys.argv[2]}".lower(); applied = (k("FilterApplied", "filterApplied") or "").lower()
if applied and applied != want:
    print(f"FILTER MISMATCH: asked {want!r}, ran {applied!r}", file=sys.stderr); sys.exit(1)
if sys.argv[3]: json.dump(r, open(sys.argv[3], "w"))
s = {n.lower(): v for n, v in (k("Summary", "summary") or {}).items()}
print("%s/%s passed, %s failed, %s skipped" % tuple(s.get(n) for n in ("passed", "total", "failed", "skipped")))
if not s.get("total"):
    print(f"no tests matched {sys.argv[2]!r} ({sys.argv[1]})", file=sys.stderr); sys.exit(1)
bad = [t for t in (k("Results", "results") or []) if (t.get("Status") or t.get("status")) not in ("Passed", "Skipped")]
for t in bad: print("FAIL", t.get("FullName") or t.get("fullName")); print("   ", (t.get("Message") or t.get("message") or "").strip()[:300])
sys.exit(1 if bad else 0)
' "$TYPE" "$FILTER" "$RESULT_FILE"
