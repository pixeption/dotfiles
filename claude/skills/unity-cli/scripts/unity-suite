#!/usr/bin/env bash
# unity-suite <project> [--failed-only <report.xml>] [--mode EditMode|PlayMode] [--timeout <seconds>]
#             [--filter <A|B>] [--assemblies <A;B>] [--category <expr>] [--output <report.xml>]
# unity-suite <project> --shards <N> --shard-root <dir> [--timeout <s>] [--output <report.xml>]
#
# --shards runs the full Edit-Mode suite across N warm copies <dir>/shard-<k>/<project name>, one
# batch editor each, and leaves <project> and its editor alone (run_shards).
# A filtered Edit-Mode run goes to the open editor through unity-test, leaving it open, when that
# editor never entered Play this session and its run selects what a batch run would (live_blocker,
# excluded_tests). Everything else follows Game/CLAUDE.md's clean-suite rule: a Play-mode session
# poisons a live editor, so the run happens in a fresh batch editor with nothing holding the project
# lock. That path closes any live editor first, runs `unity test`, and reopens the editor if one was
# open; a live run whose term enters Play before the last term falls back to it for the whole
# filter. Both paths end in an NUnit XML report (--output, else a temp file) whose pass/fail this
# parses — `unity test`'s exit code collapses every failure into a plain 6, so it only tells you
# the run started, never why it ended.
# Exit 0 all passed, 1 some failed, 2 the run never produced a report or ran 0 tests.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
source "$HERE/_common.sh"
DIE_CODE=2

# TIMEOUT: 30 min is many times a full suite (Pipeline.UI runs ~2 min) yet still ends a hung batch
# editor, which `unity test` alone would wait on forever.
USAGE="usage: unity-suite <project> [--failed-only <report.xml>] [--mode EditMode|PlayMode] [--timeout <s>] [--filter <A|B>] [--assemblies <A;B>] [--category <expr>] [--output <report.xml>]
       unity-suite <project> --shards <N> --shard-root <dir> [--timeout <s>] [--output <report.xml>]"
# A bare call would close the editor and run the full suite, so it must name what to run.
[[ $# -eq 0 ]] && die "$USAGE"
ARG="."; MODE=EditMode; FAILED=""; OUTPUT=""; TIMEOUT=1800; FILTER=""; ASSEMBLIES=""; CATEGORY=""
SHARDS=""; SHARD_ROOT=""
while [[ $# -gt 0 ]]; do case "$1" in
  --shards) SHARDS=$2; shift 2;;
  --shard-root) SHARD_ROOT=$2; shift 2;;
  --failed-only) FAILED=$2; shift 2;;
  --output) OUTPUT=$2; shift 2;;
  --mode) MODE=$2; shift 2;;
  --timeout) TIMEOUT=$2; shift 2;;
  --filter) FILTER=$2; shift 2;;
  --assemblies) ASSEMBLIES=$2; shift 2;;
  --category) CATEGORY=$2; shift 2;;
  -*) die "$USAGE";;
  *) ARG=$1; shift;;
esac; done
PROJECT=$(resolve_project "$ARG") || exit 2

if [[ -n "$SHARDS$SHARD_ROOT" ]]; then
  [[ "$SHARDS" =~ ^[1-9][0-9]*$ && -n "$SHARD_ROOT" ]] || die "--shards <N ≥ 1> and --shard-root <dir> go together"
  [[ -z "$FAILED$FILTER$ASSEMBLIES$CATEGORY" && "$MODE" == EditMode ]] \
    || die "--shards runs the whole Edit-Mode suite: no --mode, --failed-only, --filter, --assemblies or --category"
fi

# Unity reads neither list with commas: the run matches 0 tests and still exits 0.
[[ "$FILTER$ASSEMBLIES" == *,* ]] && die "no commas: --filter joins names with |, --assemblies with ;"

# --rerun-failed reads the *previous* run's report from wherever --output points (there is no
# separate "report to rerun" flag) — so rerunning failures means pointing --output at that same file.
RERUN=""
if [[ -n "$FAILED" ]]; then
  [[ -f "$FAILED" ]] || die "--failed-only report not found: $FAILED"
  RERUN=--rerun-failed
  OUTPUT=${OUTPUT:-$FAILED}
fi
if [[ -n "$OUTPUT" ]]; then
  mkdir -p "$(dirname "$OUTPUT")" || die "cannot create the directory of --output $OUTPUT"
  REPORT="$(cd "$(dirname "$OUTPUT")" && pwd)/$(basename "$OUTPUT")"
  [[ -n "$FAILED" && ! "$FAILED" -ef "$REPORT" ]] && cp "$FAILED" "$REPORT"
else
  REPORT=$(mktemp -t unity-suite-XXXXXX).xml
fi
# A report left at --output by an earlier run would read as this run's result.
[[ -z "$RERUN" ]] && rm -f "$REPORT"

# Unity logs one of these on every Play entry, with and without domain reload.
PLAY_ENTRY='^(Entering Playmode|Reloading assemblies for play mode)'

# 0 when the editor's session log shows a Play entry, or cannot be read as its own: the log covers
# the whole session, so only a readable log of ours without one shows the editor never played.
played() {
  log_is_ours || return 0
  grep -Eiq "$PLAY_ENTRY" "$(editor_log)"
  (( $? != 1 ))
}

# Prints why the run cannot go to the open editor; nothing when it can.
live_blocker() {
  if [[ "$MODE" != EditMode ]]; then echo "a $MODE run"
  elif [[ -z "$FILTER" ]]; then echo "no --filter: the full suite"
  elif [[ -n "$RERUN$ASSEMBLIES" ]]; then echo "--failed-only and --assemblies are batch-only"
  elif [[ -n "$CATEGORY" && ! "$CATEGORY" =~ ^![A-Za-z0-9_]+$ ]]; then echo "--category other than !<Name>"
  elif ! editor_open "$PROJECT"; then echo "no open editor"
  elif played; then echo "the open editor entered Play this session, or its log cannot show it did not"
  fi
}

# The live runner matches each --filter term as a substring and knows no categories, so it is exact
# only when no test those terms match carries the excluded category. Prints the first such test;
# fails when the editor's test list cannot be read.
excluded_test() {
  [[ -z "$CATEGORY" ]] && return
  result_json "$PROJECT" list_tests --mode editor | python3 -c '
import sys, json
tests = json.load(sys.stdin)["Tests"]
terms, cat = sys.argv[1].lower().split("|"), sys.argv[2].lower()
print(next((t["FullName"] for t in tests if any(x in t["FullName"].lower() for x in terms)
            and cat in (c.lower() for c in t["Categories"])), ""))
' "$FILTER" "${CATEGORY#!}" 2>/dev/null
}

# Once the live path is chosen a failure ends the run: a batch fallback would close the held editor.
# A term entering Play is the exception (run_live): the editor is poisoned for the terms after it.
live_die() { die "$*
editor left open; rerun once it is fixed"; }

# run_term <term> <result.json>: one unity-test run. A test failure still writes a fresh result.
run_term() {
  "$HERE/unity-test" "$1" --project-path "$PROJECT" --deadline "$TIMEOUT" --no-restart --result "$2" >/dev/null
  local rc=$?
  (( rc <= 1 )) && [[ -s "$2" ]] || live_die "the live run of '$1' did not finish (unity-test exit $rc)"
}

# One run per --filter term, into a private directory so no earlier attempt's result can count. A
# test two terms match is counted once, and a failure under either term is kept. Returns 1 when a
# term entered Play: the open editor is poisoned for the rest, so the caller reruns it all in batch.
run_live() {
  local terms i
  PARTS=$(mktemp -d) && trap 'rm -rf "$PARTS"' EXIT || live_die "cannot create a temp directory"
  IFS='|' read -ra terms <<<"$FILTER"
  for i in "${!terms[@]}"; do
    if played; then
      echo "the editor entered Play during this run, before '${terms[$i]}'; rerunning the whole filter in a batch editor" >&2
      return 1
    fi
    run_term "${terms[$i]}" "$PARTS/$i.json"
  done
  python3 - "$REPORT" "$PARTS"/*.json <<'MERGE' || live_die "could not merge the live results into $REPORT"
import json, sys, xml.etree.ElementTree as ET
lower = lambda d: {k.lower(): v for k, v in d.items()}
bad = lambda t: t.get("status") not in ("Passed", "Skipped")
cases = {}
for path in sys.argv[2:]:
    for t in map(lower, lower(json.load(open(path))).get("results") or []):
        if t["fullname"] not in cases or not bad(cases[t["fullname"]]): cases[t["fullname"]] = t
count = lambda status: sum(t.get("status") == status for t in cases.values())
passed, skipped = count("Passed"), count("Skipped")
run = ET.Element("test-run", total=str(len(cases)), passed=str(passed),
                 failed=str(len(cases) - passed - skipped), skipped=str(skipped))
for name, t in cases.items():
    case = ET.SubElement(run, "test-case", fullname=name, result=t.get("status") or "")
    if t.get("message"): ET.SubElement(ET.SubElement(case, "failure"), "message").text = t["message"]
ET.ElementTree(run).write(sys.argv[1], encoding="utf-8", xml_declaration=True)
MERGE
}

run_batch() {
  answers() { [[ "$(result_json "$PROJECT" editor_status)" != unreachable ]]; }
  local was_open=0 scene="" windowed="" test_json test_rc errors
  if editor_open "$PROJECT"; then
    was_open=1
    editor_windowed && windowed=--windowed
    scene=$(result_json "$PROJECT" list_open_scenes | python3 -c '
import sys, json
print(next((s["path"] for s in json.load(sys.stdin)["scenes"] if s["isActive"] and s["path"]), ""))' 2>/dev/null)
    "$HERE/unity-editor" down "$PROJECT" || { ! wait_for 30 answers 2>/dev/null && "$HERE/unity-editor" down "$PROJECT" --force; } \
      || die "could not close the live editor — refusing to run a suite that would get poisoned"
  fi

  # `unity test --timeout` is disabled by default, so a hung batch editor would wait forever.
  local nunit=(${ASSEMBLIES:+-assemblyNames "$ASSEMBLIES"} ${CATEGORY:+-testCategory "$CATEGORY"})
  test_json=$(unity test --mode "$MODE" "$PROJECT" --output "$REPORT" --timeout "$TIMEOUT" $RERUN \
    ${FILTER:+--filter "$FILTER"} --format json ${nunit[@]:+-- "${nunit[@]}"})
  test_rc=$?

  # A compile error aborts the batch run in seconds with no report; reopening the editor would only
  # fail on the same errors, so report them and leave it closed.
  if [[ ! -s "$REPORT" ]] && errors=$(compile_errors) && [[ -n "$errors" ]]; then
    echo "scripts have compiler errors - no tests ran; editor left closed. Fix, then unity-editor up:" >&2
    printf '%s\n' "$errors" >&2
    exit 2
  fi

  if [[ $was_open -eq 1 ]]; then
    "$HERE/unity-editor" up "$PROJECT" ${scene:+--scene "$scene"} $windowed \
      || echo "WARNING: could not reopen the editor that was open before this run" >&2
  fi

  if [[ ! -s "$REPORT" ]]; then
    echo "test run produced no report (unity test exit $test_rc) — it did not finish" >&2
    echo "$test_json" >&2
    exit 2
  fi
}

# The shard copies are warm projects reused run to run: a copy at a new path recompiles everything,
# a reused one only what changed. Each run rsyncs the sources but never Library/, Temp/, Logs/ or
# UserSettings/, and keeps the runner installed (excluded from --delete) so neither
# costs a recompile. The git init gives tests that need a checkout root one, outside any repo.
RUNNER_DIR=Assets/Editor/ShardRunner

# 0 when no Unity process (editor or import worker) has <project> open, whatever its argument order.
project_idle() {
  ps -ax -o command= | python3 -c '
import re, sys
host = re.compile(r"(?:^|/)Unity\"?\s")
project = re.compile(r"(?i)(?:^|\s)-projectpath\s+\"?" + re.escape(sys.argv[1]) + r"\"?(?=\s|$)")
sys.exit(1 if any(host.search(line) and project.search(line) for line in sys.stdin) else 0)
' "$1"
}

seed_shard() {                       # seed_shard <checkout> <shard project>
  project_idle "$PROJECT" || die "cannot seed $2: close the editor on $PROJECT first, so its Library clones whole"
  mkdir -p "$2" && { [[ ! -d "$PROJECT/Library" ]] || cp -cR "$PROJECT/Library" "$2/Library"; } \
    && git init -q "$1" || die "could not seed $2"
}

sync_shard() {                       # sync_shard <shard project>
  rsync -a --delete --exclude "/$RUNNER_DIR/" --exclude "/$RUNNER_DIR.meta" \
      "$PROJECT"/Assets "$PROJECT"/Packages "$PROJECT"/ProjectSettings "$1"/ \
    && mkdir -p "$1/$RUNNER_DIR" \
    && rsync -a --delete --exclude '*.meta' "$HERE/shard-runner/" "$1/$RUNNER_DIR/" \
    || die "could not sync $1"
}

# The project's installed editor binary, from `unity editors`.
editor_binary() {
  local version
  version=$(sed -n 's/^m_EditorVersion: //p' "$PROJECT/ProjectSettings/ProjectVersion.txt")
  unity editors --installed --format json 2>/dev/null | python3 -c '
import sys, json
print(next((e["location"] + "/Contents/MacOS/Unity" for e in json.load(sys.stdin)["data"]
            if e["version"] == sys.argv[1] and e.get("location")), ""))' "$version"
}

# run_shard <k> <shard project>: one batch editor running bin k; exits with the editor's status, or
# 124 after --timeout. Whatever ends the worker kills its editor. Launched directly, since
# `unity run` adds -quit and would exit before the runner's asynchronous run starts. Run it only
# with `&`: it exits, and a ( ) body would fork a second process the stop signal never reaches.
run_shard() {
  local out="$2/Logs/unity-suite-shard.xml" deadline=$((SECONDS + TIMEOUT)) pid="" rc
  trap '[[ -z "$pid" ]] || { kill -KILL "$pid"; wait "$pid"; } 2>/dev/null' EXIT
  trap 'exit 143' TERM
  mkdir -p "$2/Logs" && rm -f "$out" "$out.plan.json" || die "could not prepare shard $1's reports"
  "$UNITY" -batchmode -projectPath "$2" -logFile "$2/Logs/Editor.log" -executeMethod UnitySuite.ShardRunner.Run \
    -shard "$1/$SHARDS" -shardOut "$out" ${TIMINGS[@]:+"${TIMINGS[@]}"} >/dev/null 2>&1 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    (( SECONDS < deadline )) || { echo "shard $1 timed out after ${TIMEOUT}s" >&2; exit 124; }
    sleep 1
  done
  wait "$pid"; rc=$?; pid=""
  exit "$rc"
}

stop_shards() {
  local p
  for p in "${pids[@]}"; do kill -TERM "$p" 2>/dev/null; done
  for p in "${pids[@]}"; do wait "$p" 2>/dev/null; done
}

run_shards() {
  local root k shard pids=() timings p rc broken=0
  mkdir -p "$SHARD_ROOT" && root=$(cd "$SHARD_ROOT" && pwd) || die "cannot create --shard-root $SHARD_ROOT"
  # The last merged report: its per-test durations balance the next split.
  timings="$root/timings.xml"
  TIMINGS=(); [[ -f "$timings" ]] && TIMINGS=(-timings "$timings")
  UNITY=$(editor_binary); [[ -x "$UNITY" ]] || die "no installed editor for $PROJECT's ProjectVersion.txt (unity editors --installed)"
  echo "running in $SHARDS shard editors under $root" >&2
  for ((k = 1; k <= SHARDS; k++)); do
    shard="$root/shard-$k/$(basename "$PROJECT")"
    [[ -d "$shard" ]] || seed_shard "$root/shard-$k" "$shard"
    project_idle "$shard" || die "$shard is held by a running editor"
    sync_shard "$shard"
  done
  trap stop_shards EXIT; trap 'exit 130' INT; trap 'exit 143' TERM
  for ((k = 1; k <= SHARDS; k++)); do
    shard="$root/shard-$k/$(basename "$PROJECT")"
    run_shard "$k" "$shard" &
    pids+=($!)
  done
  # The runner exits 2 when a test failed, which fails the run even if no report shows it. Anything else
  # non-zero is a crash or a timeout, which fails the run even after a report was written.
  export UNITY_SUITE_SHARD_FAILED=0
  for p in "${pids[@]}"; do
    wait "$p"; rc=$?
    case $rc in
      0) ;;
      2) UNITY_SUITE_SHARD_FAILED=1;;
      *) echo "shard worker $p exited $rc" >&2; broken=1;;
    esac
  done
  trap - EXIT INT TERM

  python3 - "$REPORT" "$root" "$(basename "$PROJECT")" "$SHARDS" <<'MERGE' || exit 2
import json, os, re, sys, xml.etree.ElementTree as ET
report, root, name, shards = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
run, seen, problems, totals, inventory, explicit = ET.Element("test-run"), {}, [], set(), None, []
for k in range(1, shards + 1):
    part = f"{root}/shard-{k}/{name}/Logs/unity-suite-shard.xml"
    if not (os.path.isfile(part) and os.path.isfile(part + ".plan.json")):
        log = f"{root}/shard-{k}/{name}/Logs/Editor.log"
        errors = sorted({l.strip() for l in open(log, errors="replace") if re.search(r"error CS\d+", l)}) if os.path.isfile(log) else []
        problems.append(f"shard {k} wrote no report; see {log}" + "".join("\n    " + e for e in errors[:20]))
        continue
    plan, tree = json.load(open(part + ".plan.json")), ET.parse(part).getroot()
    listed = plan["allTests"]
    if len(listed) != plan["total"] or len(set(listed)) != len(listed):
        problems.append(f"shard {k}: invalid or duplicate test inventory")
    totals.add(plan["total"])
    if inventory is None: inventory, explicit = plan["allTests"], plan["explicitTests"]
    elif (plan["allTests"], plan["explicitTests"]) != (inventory, explicit):
        problems.append(f"shard {k}: its test list differs from shard 1's")
    ran = [tc.get("fullname") for tc in tree.iter("test-case")]
    for test in ran:
        if test in seen: problems.append(f"duplicate: {test} in shards {seen[test]} and {k}")
        seen[test] = k
    planned, actual = set(plan["tests"]), set(ran)
    if planned != actual:
        problems.append(f"shard {k}: planned tests did not run: {sorted(planned - actual)[:3]}, "
                        f"unplanned tests ran: {sorted(actual - planned)[:3]}")
    print(f"shard {k}: {len(ran)} tests, {float(tree.get('duration', 0)):.0f} s", file=sys.stderr)
    run.extend(tree if tree.tag == "test-run" else [tree])
if len(totals) > 1: problems.append(f"the shards saw different test lists: {sorted(totals)} tests")
for test in explicit:
    if test in seen: problems.append(f"duplicate: explicit test {test} ran in shard {seen[test]}")
    ET.SubElement(run, "test-case", fullname=test, name=test, result="Skipped", label="Explicit")
if totals and len(seen) + len(explicit) != max(totals):
    problems.append(f"{len(seen)} ran + {len(explicit)} explicit != {max(totals)} tests listed")
if inventory is not None and set(seen) | set(explicit) != set(inventory):
    problems.append("the merged tests differ from the listed tests")
for p in problems: print(p, file=sys.stderr)
if problems: sys.exit(1)
count = lambda result: str(sum(tc.get("result") == result for tc in run.iter("test-case")))
run.attrib.update(total=str(len(seen) + len(explicit)), passed=count("Passed"), failed=count("Failed"),
                  inconclusive=count("Inconclusive"), skipped=count("Skipped"))
ET.ElementTree(run).write(report, encoding="utf-8", xml_declaration=True)
MERGE
  (( broken == 0 )) || DIE_CODE=2 die "a shard editor crashed or timed out (see its Logs/Editor.log)"
  cp "$REPORT" "$timings"
}

if [[ -n "$SHARDS" ]]; then
  run_shards
else
  WHY=$(live_blocker)
  if [[ -z "$WHY" ]]; then
    ERRORS=$(UNITY_PROJECT_PATH="$PROJECT" "$HERE/unity-wait" recompile) || {
      [[ -n "$ERRORS" ]] && live_die "scripts have compiler errors - no tests ran:
$ERRORS"
      live_die "editor hung - unity-editor ensure '$PROJECT'; the recompile did not finish, no tests ran"; }
    HIT=$(excluded_test) || live_die "could not read the editor's test list to check --category $CATEGORY"
    [[ -n "$HIT" ]] && WHY="--filter matches $HIT, in category ${CATEGORY#!}"
  fi
  if [[ -z "$WHY" ]]; then
    echo "running in the open editor" >&2
    run_live || run_batch
  else
    echo "running in a batch editor: $WHY" >&2
    run_batch
  fi
fi

python3 - "$REPORT" <<'PY'
import os, sys, time, xml.etree.ElementTree as ET

root = ET.parse(sys.argv[1]).getroot()
run = root if root.tag == "test-run" else root.find(".//test-run")
attrs = run.attrib if run is not None else root.attrib
total, passed = attrs.get("total", "?"), attrs.get("passed", "?")
failed, skipped = attrs.get("failed", "0"), attrs.get("skipped", "0")
print(f"{passed}/{total} passed, {failed} failed, {skipped} skipped")
finished = time.strftime("%H:%M", time.localtime(os.path.getmtime(sys.argv[1])))
print(f"report: {sys.argv[1]} · finished {finished}")
if total == "0":
    print("0 tests ran: the filter or assembly list matched nothing", file=sys.stderr)
    sys.exit(2)

# A suite fails on its own (site other than Child) when its OneTimeSetUp/TearDown throws, even when
# every test case in it passed.
bad = [n for n in root.iter() if (n.tag == "test-case" and n.get("result") not in ("Passed", "Skipped", "Warning"))
       or (n.tag == "test-suite" and n.get("result") == "Failed" and n.get("site") != "Child")]
for tc in bad:
    msg = tc.find("./failure/message")
    print("FAIL", tc.get("fullname") or tc.get("name"))
    print("   ", (msg.text or "").strip()[:300] if msg is not None else "")
sys.exit(1 if bad or failed != "0" or os.environ.get("UNITY_SUITE_SHARD_FAILED") == "1" else 0)
PY
