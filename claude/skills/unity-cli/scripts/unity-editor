#!/usr/bin/env bash
# unity-editor up [project] [--scene <path.unity>] [--windowed]   open (or reuse) a live editor
# unity-editor down [project] [--force]                           close it
# unity-editor restart [project] [--scene <s>] [--windowed]       force-close, then up
# unity-editor ensure [project] [--deadline 30]                   restart only if editor_status stays silent
#
# A new editor is headless (-batchmode without -quit, logging to <project>/Logs/Editor.log): a window
# takes the user's focus on every launch, and nothing stops it. --windowed opens today's GUI editor
# for anything that needs a visible window. restart and ensure keep a windowed editor windowed.
#
# ensure: an editor that answers nothing for the deadline is hung (a modal dialog, a main-thread
# deadlock - "/api/exec ... Main thread operation timed out"), and no further command will get
# through; force-close and relaunch it rather than retrying. Rule out active work first: a
# detached test run still holds the exec gate, so editor_status can go quiet while it works.
#
# up: skips `unity open` if the project already has a live editor (checked via `unity status`,
# never assumed from a prior run), waits for it with unity-wait, enables autotick (an unfocused
# GUI editor stalls recompiles/tests without it), clears the console, then reports the active
# scene — opening --scene first when a different one is active (a headless editor always starts on
# an untitled scene, a windowed one restores whatever was last open). A compile error makes a
# headless editor exit 1 and opens a windowed one into Safe Mode, where no pipeline server ever
# starts: either way up fails within seconds, prints the errors, closes any Safe Mode editor and
# exits 1 instead of waiting out the deadline. An editor whose Pipeline server could not
# bind a port ("Failed to start Pipeline Server") is closed and relaunched once: with an
# auto-assigned port (m_Port 0) that is a lost probe-then-bind race against an editor starting at
# the same moment, and the relaunch probes again. A second failure closes it and exits 1.
# down: `unity close` exits 0 for a project with no editor.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
source "$HERE/_common.sh"

MODE="${1:-}"
case "$MODE" in up|down|restart|ensure) ;; *) die "usage: unity-editor up|down|restart|ensure [project] [--scene <s>] [--windowed] [--force] [--deadline <s>]";; esac
shift
ARG="."; SCENE=""; FORCE=""; DEADLINE=30; WINDOWED=""
while [[ $# -gt 0 ]]; do case "$1" in
  --scene) SCENE=$2; shift 2;;
  --windowed) WINDOWED=1; shift;;
  --force) FORCE=--force; shift;;
  --deadline) DEADLINE=$2; shift 2;;
  -*) die "unknown option $1";;
  *) ARG=$1; shift;;
esac; done
PROJECT=$(resolve_project "$ARG") || exit 1

if [[ "$MODE" == down ]]; then
  unity close "$PROJECT" $FORCE
  exit $?
fi

answers() { [[ "$(result_json "$PROJECT" editor_status)" != unreachable ]]; }

if [[ "$MODE" == ensure ]]; then
  if ! editor_open "$PROJECT"; then echo "no live editor for $PROJECT"; exit 3; fi
  if wait_for "$DEADLINE" answers 2>/dev/null; then echo "editor responsive"; exit 0; fi
  echo "editor silent for ${DEADLINE}s - hung; restarting" >&2
  MODE=restart
fi

force_close() {
  unity close "$PROJECT" --force >/dev/null 2>&1
  wait_for 30 not_running || die "unity close --force left the editor running - check: pgrep -fl 'Unity -projectpath'"
}

if [[ "$MODE" == restart ]]; then
  editor_windowed && WINDOWED=1
  force_close
fi

export LAUNCH_MARKER; LAUNCH_MARKER=$(mktemp); trap 'rm -f "$LAUNCH_MARKER"' EXIT
launch() {
  touch "$LAUNCH_MARKER"
  local args="-batchmode -automated -logFile $PROJECT/Logs/Editor.log"
  [[ -n "$WINDOWED" ]] && args="-automated"
  mkdir -p "$PROJECT/Logs"
  unity open "$PROJECT" --args "$args" >/dev/null || die "unity open failed"
  UNITY_PROJECT_PATH="$PROJECT" "$HERE/unity-wait" ready
}

if ! editor_open "$PROJECT"; then
  launch; RC=$?
  if (( RC == 3 )); then
    echo "relaunching once so the Pipeline server probes for a free port again" >&2
    force_close; launch; RC=$?
  fi
  case $RC in
    0) ;;
    1) # Compile errors: a Safe Mode editor has nothing to drive and only blocks the next `unity open`.
       force_close
       die "fix the compile errors above, then re-run unity-editor up";;
    3) force_close
       die "closed the editor - its Pipeline server failed twice; is m_Port in ProjectSettings/Packages/com.unity.pipeline/EditorPipelineConfig.json pinned to a port in use?";;
    *) exit 2;;
  esac
fi

unity command set_autotick --project-path "$PROJECT" --enable true --format json >/dev/null \
  || die "set_autotick failed — is the editor really up?"
unity command clear_console --project-path "$PROJECT" --format json >/dev/null 2>&1 || true

active_scene() {
  result_json "$PROJECT" list_open_scenes | python3 -c '
import sys, json
a = next((s for s in json.load(sys.stdin)["scenes"] if s["isActive"]), None)
print("%s\t%s" % (a["path"] or a["name"] or "(untitled)", a["rootCount"]) if a else "(none)\t0")'
}

IFS=$'\t' read -r ACTIVE ROOTS <<<"$(active_scene)"
if [[ -n "$SCENE" && "$SCENE" != "$ACTIVE" ]]; then
  unity command open_scene --project-path "$PROJECT" --path "$SCENE" --format json >/dev/null \
    || die "open_scene failed for $SCENE (active: $ACTIVE)"
  IFS=$'\t' read -r ACTIVE ROOTS <<<"$(active_scene)"
fi
echo "active scene: $ACTIVE (rootCount $ROOTS)"
