#!/usr/bin/env python3
"""Print codex's 5h and weekly usage from the newest rate_limits snapshot codex wrote.

Codex records `rate_limits` on every token_count event in ~/.codex/sessions/**/*.jsonl
(primary = 300 min window, secondary = 10080 min). This reads the newest one; it is a
snapshot from the last codex turn, not a live query. Exit 0 = ok to route to codex,
exit 1 = over a threshold (route to Claude), exit 2 = no snapshot found.

  codex-usage [--five-hour 80] [--weekly 90] [--max-age-min 120]
"""
import argparse, glob, json, os, sys, time

p = argparse.ArgumentParser()
p.add_argument("--five-hour", type=float, default=80, help="max used%% of the 5h window")
p.add_argument("--weekly", type=float, default=90, help="max used%% of the weekly window")
p.add_argument("--max-age-min", type=float, default=120, help="warn if the snapshot is older")
a = p.parse_args()

files = sorted(glob.glob(os.path.expanduser("~/.codex/sessions/**/*.jsonl"), recursive=True),
               key=os.path.getmtime, reverse=True)
snap = None
for f in files[:20]:
    with open(f, errors="replace") as fh:
        for line in fh:
            if '"rate_limits"' not in line:
                continue
            try:
                rl = json.loads(line)["payload"]["rate_limits"]
                ts = json.loads(line)["timestamp"]
            except (KeyError, ValueError):
                continue
            if rl.get("primary"):
                snap = (ts, rl)
    if snap:
        break
if not snap:
    print("codex-usage: no rate_limits snapshot found under ~/.codex/sessions", file=sys.stderr)
    sys.exit(2)

ts, rl = snap
def window(w, name):
    if not w:
        return f"{name}: n/a", 0.0
    if w["resets_at"] <= time.time():
        return f"{name}: window reset since snapshot (0%)", 0.0
    reset = time.strftime("%Y-%m-%d %H:%M", time.localtime(w["resets_at"]))
    return f"{name}: {w['used_percent']:.0f}% used, resets {reset}", w["used_percent"]

five, five_pct = window(rl.get("primary"), "5h")
week, week_pct = window(rl.get("secondary"), "weekly")
age_min = (time.time() - time.mktime(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S")) + time.timezone) / 60
stale = " (STALE — run a codex turn to refresh)" if age_min > a.max_age_min else ""
print(f"{five} · {week} · plan {rl.get('plan_type')} · snapshot {age_min:.0f} min old{stale}")
if rl.get("rate_limit_reached_type"):
    print(f"codex reports limit reached: {rl['rate_limit_reached_type']}")
    sys.exit(1)
over = five_pct >= a.five_hour or week_pct >= a.weekly
print("ROUTE: Claude (codex over threshold)" if over else "ROUTE: codex ok")
sys.exit(1 if over else 0)
