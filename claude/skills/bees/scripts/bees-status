#!/usr/bin/env python3
"""Derive a bees plan's status from what already exists: nothing here is a store.

The plan's `## Checklist` is the unit list; rounds are the out-files in docs/plans/<plan>.work/
and their .usage/.session/.cwd sidecars; landed is a `Bees-Unit: <plan-slug>/<unit>` git trailer
in the row's Repo; decisions and acceptances are one-line notes in <plan>.notes.md. `show --write`
renders the Status column back into the plan; it is idempotent, so it can fire from anywhere.

  bees-status --plan <plan.md> show [--write] [--log | --takeover]   (or set BEES_PLAN)
  bees-status --plan <plan.md> note [unit] "text"         first token: accept: decision: gap:
                                                            concern: blocked-on: handoff:
  bees-status --plan <plan.md> capture-bee -u <unit>... --role impl|review --ctx <tokens> < report
  bees-status round-out --role impl|review -u <unit>... -o <plan>.work/[<out-file>]   (wrappers)
  bees-status refresh [--root <dir>]      hooks: refresh every plan with a docs/plans/*.work/ dir
"""
import argparse, contextlib, datetime as dt, fcntl, functools, glob, json, os, re, subprocess, sys, tempfile


def die(msg):
    sys.exit(f"bees-status: {msg}")


def cell(s):
    return str(s or "—").replace("|", "\\|").replace("\n", " ")


def table(cols, rows):
    out = ["| " + " | ".join(cols) + " |", "|" + "---|" * len(cols)]
    out += ["| " + " | ".join(cell(c) for c in r) + " |" for r in rows]
    return "\n".join(out)


# ---------- derived view: the plan's checklist is the unit list ----------

COLUMNS = ("ID", "Item", "Repo", "Pts", "Route", "Phase", "Depends", "Status")
ID_LINK = re.compile(r"\[([^\]]+)\]\(#([^)]*)\)")
DONE_MARK = re.compile(r" \*\*✅ Done \d{4}-\d\d-\d\d\*\*$")
HASH = re.compile(r"[0-9a-f]{7,40}")


def pipes(line):
    out, code, prev = [], False, ""
    for i, ch in enumerate(line):
        if ch == "`":
            code = not code
        elif ch == "|" and not code and prev != "\\":
            out.append(i)
        prev = ch
    return out


def cells(line):
    p = pipes(line)
    return [line[a + 1:b].strip() for a, b in zip(p, p[1:])]


def set_cell(line, k, text):
    p = pipes(line)
    return line[:p[k] + 1] + f" {text} " + line[p[k + 1]:]


def gh_slug(heading):
    t = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", heading.lstrip("#").strip())
    t = re.sub(r"[^\w\- ]", "", t.replace("`", "").replace("*", "").lower())
    return t.replace(" ", "-")


def git(repo, *args):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else None


@functools.lru_cache(None)
def git_root(path):
    top = git(path, "rev-parse", "--show-toplevel") if os.path.isdir(path) else None
    return top and os.path.realpath(top.strip())


def read_text(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def atomic_write(path, text):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".bees-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, os.stat(path).st_mode & 0o7777 if os.path.exists(path) else 0o644)
    os.replace(tmp, path)


class Plan:
    def __init__(self, path):
        self.path = os.path.abspath(path)
        os.path.isfile(self.path) and self.path.endswith(".md") or die(f"no plan .md at {path}")
        self.base = self.path[:-3]
        self.slug = re.sub(r"^\d{4}-\d\d-\d\d-", "", os.path.basename(self.base))
        self.work, self.notes = self.base + ".work", self.base + ".notes.md"
        self.root = git_root(os.path.dirname(self.path)) or die(f"{path} is not inside a git repository")
        self.lines = read_text(self.path).split("\n")
        self.units = self.parse_units()

    def checklist(self):
        start = next((i for i, l in enumerate(self.lines) if l.strip() == "## Checklist"), None)
        start is not None or die(f"{self.path}: no '## Checklist' section")
        rows = []
        for n in range(start + 1, len(self.lines)):
            line = self.lines[n]
            if line.startswith("|"):
                rows.append(n)
            elif rows or line.startswith("## "):
                break
        len(rows) >= 2 or die(f"{self.path}: '## Checklist' has no table")
        return cells(self.lines[rows[0]]), rows[2:]

    def parse_units(self):
        header, rows = self.checklist()
        missing = [c for c in COLUMNS if c not in header]
        missing and die(f"{self.path}: checklist lacks column(s) {', '.join(missing)}")
        self.col = {c: header.index(c) for c in COLUMNS}
        units = {}
        for n in rows:
            c = cells(self.lines[n])
            len(c) == len(header) or die(f"{self.path}:{n + 1}: {len(c)} cells, header has {len(header)}")
            get = lambda k: c[self.col[k]]
            link = ID_LINK.fullmatch(get("ID"))
            uid = link[1] if link else get("ID")
            uid not in units or die(f"{self.path}: duplicate unit id {uid}")
            dep = get("Depends")
            units[uid] = {"id": uid, "line": n, "href": link and link[2], "repo": get("Repo").strip("`"), "pts": get("Pts"),
                          "route": get("Route"), "phase": get("Phase"), "status": get("Status"),
                          "depends": [] if dep in ("", "-", "—") else [d.strip() for d in dep.split(",")]}
        for u in units.values():
            unknown = [d for d in u["depends"] if d not in units]
            unknown and die(f"{self.path}: {u['id']} depends on unknown {', '.join(unknown)}")
            path = os.path.normpath(os.path.join(self.root, u["repo"]))
            git_root(path) == os.path.realpath(path) or die(f"{self.path}: {u['id']} names unknown repo {u['repo']}")
            u["repo_path"] = path
        return units


# ---------- rounds: out-files in the plan's .work/ dir ----------

ROLES = ("impl", "review")
ROUND_NAME = re.compile(r"(impl|review)-(.+)-r([1-9]\d*)\.txt")


def round_out(role, units, out):
    """Validate a round's role, units and -o before anything is written → (plan, out-file path)."""
    role in ROLES or die(f"--role must be impl or review, not {role!r}")
    units or die("need one or more -u <unit>")
    len(set(units)) == len(units) or die(f"repeated -u in {' '.join(units)}")
    out = os.path.abspath(out)
    work = out if out.endswith(".work") else os.path.dirname(out)
    in_work = [p for p in work.split(os.sep) if p.endswith(".work")]
    work.endswith(".work") and len(in_work) == 1 or die(f"-o must be inside exactly one docs/plans/<plan>.work/ dir: {out}")
    plan = Plan(work[:-len(".work")] + ".md")
    plans_dir = os.path.realpath(os.path.join(plan.root, "docs", "plans"))
    os.path.realpath(os.path.dirname(plan.path)) == plans_dir or die(f"-o must be inside {plans_dir}/<plan>.work/: {out}")
    unknown = [u for u in units if u not in plan.units]
    unknown and die(f"unknown unit(s) {', '.join(unknown)} in {plan.path}")
    stem = f"{role}-{'+'.join(units)}"
    if out == work:
        taken = [int(m[3]) for m in map(ROUND_NAME.fullmatch, round_names(work)) if m and f"{m[1]}-{m[2]}" == stem]
        out = os.path.join(work, f"{stem}-r{max(taken, default=0) + 1}.txt")
    m = ROUND_NAME.fullmatch(os.path.basename(out))
    m and f"{m[1]}-{m[2]}" == stem or die(f"out-file must be named {stem}-r<N>.txt, not {os.path.basename(out)}")
    any(os.path.exists(out + s) for s in ("", ".log", ".usage")) and die(f"{out} already holds a round; use the next -r<N>")
    os.makedirs(work, exist_ok=True)
    return plan, out


def round_names(work):
    names = os.listdir(work) if os.path.isdir(work) else []
    return sorted({n[:n.index(".txt") + 4] for n in names if ".txt" in n})


def sidecar(out, ext):
    try:
        return read_text(out + ext).strip() or None
    except FileNotFoundError:
        return None


def usage_ctx(out):
    try:
        ctx = json.loads(sidecar(out, ".usage") or "{}").get("context_tokens")
    except ValueError:
        return None
    return ctx if isinstance(ctx, int) else None


def read_rounds(plan):
    rounds = []
    for name in round_names(plan.work):
        m = ROUND_NAME.fullmatch(name)
        out = os.path.join(plan.work, name)
        clock = next((out + s for s in (".usage", "", ".log") if os.path.exists(out + s)), None)
        if not m or not clock:
            continue
        finished = clock.endswith(".usage")
        r = {"path": out, "name": name, "role": m[1], "units": m[2].split("+"), "n": int(m[3]),
             "finished": finished, "time": os.stat(clock).st_mtime_ns / 1_000_000_000, "ctx": usage_ctx(out),
             "session": sidecar(out, ".session"), "cwd": sidecar(out, ".cwd")}
        r.update(parse_report(r, plan) if finished else {"valid": False, "entries": {}, "why": "unfinished"})
        rounds.append(r)
    return rounds


def trailer_commits(repo):
    """Every commit reachable from HEAD with its committer epoch and exact Bees-Unit trailer values."""
    out = git(repo, "log", "--format=%H%x1f%ct%x1f%(trailers:key=Bees-Unit,valueonly)%x1f%s%x1e") or ""
    commits = []
    for rec in filter(None, (r.strip("\n") for r in out.split("\x1e"))):
        h, ct, trailers, subject = rec.split("\x1f")
        commits.append({"hash": h, "time": int(ct), "units": set(trailers.split()), "subject": subject})
    return commits


def landings(plan, uid, commits):
    key = f"{plan.slug}/{uid}"
    return [(c["hash"], c["time"]) for c in commits if key in c["units"]]


STATES = ("done", "blocked", "paused", "needs-decision")
VERDICTS = ("APPROVE", "CHANGES_REQUIRED")


def parse_report(r, plan):
    try:
        text = read_text(r["path"])
    except FileNotFoundError:
        text = ""
    entries, why = parse_bees(r["role"], text, r["units"], plan.units)
    return {"valid": why is None, "entries": entries, "why": why}


def parse_bees(role, text, units, known):
    """The VIEW-03 last-line contract → (entries, None) or ({}, why it is malformed)."""
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    at = [i for i, l in enumerate(lines) if l.startswith("BEES:")]
    if len(at) != 1:
        return {}, "duplicated BEES line" if at else "no BEES line"
    impl = role == "impl"
    if not impl and lines[-1] not in VERDICTS:
        return {}, "no terminal APPROVE/CHANGES_REQUIRED"
    if at[0] != len(lines) - (1 if impl else 2):
        return {}, "BEES line is not " + ("the last line" if impl else "right above the verdict")
    key = "results" if impl else "reviews"
    m = re.fullmatch(rf"BEES: {key}=(\S+)", lines[at[0]])
    if not m:
        return {}, f"not a 'BEES: {key}=' line"
    entries = {}
    for e in m[1].split(";"):
        parts = e.split(":")
        ids = [] if parts[-1] == "-" else parts[-1].split(",")
        if len(parts) != (3 if impl else 2) or impl and parts[1] not in STATES or "" in ids:
            return {}, f"bad entry {e!r}"
        if parts[0] in entries:
            return {}, f"unit {parts[0]} duplicated"
        entries[parts[0]] = (parts[1], ids) if impl else ids
    if set(entries) != set(units) or any(u not in known for u in entries):
        return {}, f"units {'+'.join(entries)} do not match the round's {'+'.join(units)}"
    if not impl and (lines[-1] == "APPROVE") == any(entries.values()):
        return {}, "APPROVE with open ids" if lines[-1] == "APPROVE" else "CHANGES_REQUIRED with no open id"
    return entries, None


def cmd_capture_bee(plan, units, role, ctx):
    role in ROLES or die(f"--role must be impl or review, not {role!r}")
    re.fullmatch(r"[1-9][0-9]*", ctx or "") or die(f"--ctx must be a positive base-10 integer, not {ctx!r}")
    report = sys.stdin.read()
    report.strip() or die("empty report on stdin")
    _, out = round_out(role, units, plan.work)
    atomic_write(out, report)
    atomic_write(out + ".usage", json.dumps({"context_tokens": int(ctx), "source": "harness"}) + "\n")
    why = parse_bees(role, report, units, plan.units)[1]
    print(f"ok {out}" + (f" · malformed result: {why}" if why else ""))


# ---------- notes: the only typed log ----------

NOTE_LINE = re.compile(r"(?:- )?(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ) (?:\[([^\]\s]+)\] )?(.*)")
PREFIXES = ("accept:", "decision:", "gap:", "concern:", "blocked-on:", "handoff:")


def read_notes(plan):
    try:
        lines = read_text(plan.notes).splitlines()
    except FileNotFoundError:
        return []
    notes = []
    for m in filter(None, map(NOTE_LINE.fullmatch, lines)):
        first = m[3].split(" ", 1)[0]
        notes.append({"time": m[1], "unit": m[2], "text": m[3], "kind": first if first in PREFIXES else None})
    return notes


def cmd_note(plan, args):
    len(args) in (1, 2) or die('note [unit] "text" — quote the text')
    unit, text = (None, args[0]) if len(args) == 1 else args
    unit is None or unit in plan.units or die(f"unknown unit {unit} in {plan.path}")
    text = text.strip()
    text and "\n" not in text or die("a note is one non-empty line; anything longer is a checklist row")
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    line = f"{stamp} " + (f"[{unit}] " if unit else "") + text
    with open(plan.notes, "a", encoding="utf-8") as f:
        f.write(f"- {line}\n")
    print(f"ok {line}")


def unit_status(uid, rounds, landings, notes):
    """The precedence table of VIEW-01, newest artifact first: → mark, qualifier, accept date, open review ids."""
    accepted = [n["time"][:10] for n in notes if n["unit"] == uid and n["kind"] == "accept:"]
    if accepted:
        return {"mark": "✅", "qual": "", "date": accepted[0], "open": []}
    mine = [r for r in rounds if uid in r["units"]]
    last = newest(r for r in mine if r["role"] == "impl" and r["valid"])
    landed = max((t for _, t in landings), default=None)
    verdict = lambda mark, qual="", open_=(): {"mark": mark, "qual": qual, "date": None, "open": list(open_)}
    if last and (landed is None or last["time"] >= landed):
        state, hashes = last["entries"][uid]
        if state != "done":
            return verdict("🟡", "paused") if state == "paused" else verdict("🔴", state)
        if not hashes or not all(HASH.fullmatch(x) and any(h.startswith(x) for h, _ in landings) for x in hashes):
            return verdict("🟡", "done, trailer missing")
    if landed is not None:
        review = newest(r for r in mine if r["role"] == "review" and r["valid"] and r["time"] >= landed)
        ids = review["entries"][uid] if review else []
        return verdict("🔵", "(review open)" if ids else "", ids)
    return verdict("🟡" if mine else "☐")


def newest(rounds):
    return max(rounds, key=lambda r: (r["time"], r.get("n", 0)), default=None)


def status_cell(v):
    return f"{v['mark']} {v['qual']}".strip()


def patch_plan(path, verdicts):
    """Rewrite only Status cells, accepted-heading markers and those rows' hrefs; re-reads the plan first."""
    plan = Plan(path)
    lines = plan.lines[:]
    for uid, u in plan.units.items():
        if uid not in verdicts:
            continue
        v = verdicts[uid]
        row = set_cell(lines[u["line"]], plan.col["Status"], status_cell(v))
        h = next((i for i, l in enumerate(lines) if l.startswith(f"### {uid} · ")), None)
        if h is not None:
            heading = DONE_MARK.sub("", lines[h]) + (f" **✅ Done {v['date']}**" if v["date"] else "")
            if heading != lines[h]:
                lines[h] = heading
                if u["href"] is not None:
                    row = set_cell(row, plan.col["ID"], f"[{uid}](#{gh_slug(heading)})")
        lines[u["line"]] = row
    if lines == plan.lines:
        return False
    atomic_write(plan.path, "\n".join(lines))
    return True


# ---------- the board ----------

def compute_view(plan):
    rounds, notes = read_rounds(plan), read_notes(plan)
    commits = {path: trailer_commits(path) for path in {u["repo_path"] for u in plan.units.values()}}
    view = {}
    for uid, u in plan.units.items():
        v = unit_status(uid, rounds, landings(plan, uid, commits[u["repo_path"]]), notes)
        v["rounds"] = sorted((r for r in rounds if uid in r["units"]), key=lambda r: r["time"])
        view[uid] = v
    return {"plan": plan, "units": view, "rounds": rounds, "notes": notes, "commits": commits}


def kilo(n):
    return "?" if n is None else f"{round(n / 1000)}k"


def newest_per_role(rounds):
    return [r for r in (newest(x for x in rounds if x["role"] == role and x["finished"]) for role in ROLES) if r]


def diagnostics(v):
    out = [f"open {','.join(v['open'])}"] if v["open"] else []
    for r in newest_per_role(v["rounds"]):
        if not r["valid"]:
            out.append(f"malformed result: {r['path']} ({r['why']})")
        if r["ctx"] is None:
            out.append(f"usage unavailable: {r['name']}")
    return " · ".join(out)


def next_unit(view):
    done = {uid for uid, v in view["units"].items() if v["mark"] == "✅"}
    return next((uid for uid, v in view["units"].items()
                 if v["mark"] == "☐" and all(d in done for d in view["plan"].units[uid]["depends"])), "—")


def render_board(view):
    plan, units = view["plan"], view["units"]
    counts = " · ".join(f"{m} {sum(v['mark'] == m for v in units.values())}" for m in ("✅", "🔵", "🟡", "🔴", "☐"))
    rows = []
    for uid, v in units.items():
        u = plan.units[uid]
        rounds = " · ".join(f"{role} " + " ".join(f"r{r['n']}" for r in v["rounds"] if r["role"] == role)
                            for role in ROLES if any(r["role"] == role for r in v["rounds"]))
        ctx = " · ".join(f"{r['role']} {kilo(r['ctx'])}" for r in newest_per_role(v["rounds"]))
        rows.append((uid, u["phase"], u["pts"], u["route"], status_cell(v), rounds, ctx, diagnostics(v)))
    return "\n".join([f"{plan.slug} · {counts} · {plan.path}",
                      table(["ID", "Ph", "Pts", "Route", "Status", "Rounds", "Ctx", "Detail"], rows),
                      f"Next: {next_unit(view)}"])


def utc(epoch):
    return dt.datetime.fromtimestamp(epoch, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def round_summary(r):
    if not r["valid"]:
        return f"malformed result ({r['why']})"
    if r["role"] == "impl":
        return "; ".join(f"{u} {state} {','.join(hashes) or '-'}" for u, (state, hashes) in r["entries"].items())
    return "; ".join(f"{u} " + (f"open {','.join(ids)}" if ids else "clean") for u, ids in r["entries"].items())


def repo_names(plan):
    return {u["repo_path"]: u["repo"] for u in plan.units.values()}


def render_log(view):
    plan = view["plan"]
    events = [(n["time"], "note", (f"[{n['unit']}] " if n["unit"] else "") + n["text"]) for n in view["notes"]]
    events += [(utc(r["time"]), r["role"], f"{'+'.join(r['units'])} r{r['n']} · {round_summary(r)} · {r['name']}")
               for r in view["rounds"] if r["finished"]]
    keys = {f"{plan.slug}/{uid}": uid for uid in plan.units}
    for path, commits in view["commits"].items():
        for c in commits:
            units = [keys[k] for k in sorted(c["units"]) if k in keys]
            if units:
                events.append((utc(c["time"]), "commit", f"{'+'.join(units)} · {c['hash'][:8]} {c['subject']} · {repo_names(plan)[path]}"))
    return "\n".join(f"{t}  {kind:<6}  {text}" for t, kind, text in sorted(events))


def repo_head(path):
    head = (git(path, "log", "-1", "--format=%h %s") or "").strip()
    branch = (git(path, "rev-parse", "--abbrev-ref", "HEAD") or "").strip()
    dirty = len((git(path, "status", "--porcelain") or "").splitlines())
    return f"{branch} @ {head}" + (f" · {dirty} uncommitted path(s)" if dirty else "")


def session_line(uid, r):
    where = r["cwd"] or "no .cwd"
    if r["cwd"] and not os.path.isdir(r["cwd"]):
        where += " (non-resumable: directory missing)"
    return f"- {uid} · {r['role']} r{r['n']} · session {r['session'] or '— (Claude bee)'} · ctx {kilo(r['ctx'])} · {where}"


def phase_key(phase):
    return (0, int(phase), "") if phase.isdigit() else (1, 0, phase)


def handoff_task(view):
    """→ (task, first unfinished unit): 'phase N' when phase N has not started, else 'phase N continued'."""
    plan, units = view["plan"], view["units"]
    unfinished = [uid for uid, v in units.items() if v["mark"] != "✅"]
    if not unfinished:
        return None, None
    phase = min((plan.units[uid]["phase"] for uid in unfinished), key=phase_key)
    started = any(v["mark"] != "☐" for uid, v in units.items() if plan.units[uid]["phase"] == phase)
    first = next(uid for uid in unfinished if plan.units[uid]["phase"] == phase)
    return f"{plan.slug} phase {phase}" + (" continued" if started else ""), first


def render_takeover(view):
    plan, units = view["plan"], view["units"]
    task, first = handoff_task(view)
    L = [f"# Takeover · {plan.slug}", f"Plan: {plan.path} · Next: {next_unit(view)}"]
    L += [f"Phase: {task} — first unfinished unit {first}",
          f"Handoff: ~/.claude/skills/bees/scripts/bees-status --plan {plan.path} show --takeover | ~/.claude/skills/handoff/scripts/spawn-handoff.sh"
          f' --cwd {plan.root} --task "{task}" --model <exact current model id>'] if task else ["Phase: every unit is accepted"]
    L += ["", "## Repos"]
    L += [f"- {name} · {repo_head(path)}" for path, name in repo_names(plan).items()]
    L += ["", "## Sessions (newest round per unit)"]
    L += [session_line(uid, newest(v["rounds"])) for uid, v in units.items() if v["rounds"]] or ["- none"]
    L += ["", "## Unfinished units"]
    L += [f"- {uid} {status_cell(v)} · last out-file " + (newest(v["rounds"]) or {}).get("path", "—")
          for uid, v in units.items() if v["mark"] in ("🟡", "🔴")] or ["- none"]
    for kind in ("handoff:", "blocked-on:", "concern:", "decision:", "gap:"):
        notes = [n for n in view["notes"] if n["kind"] == kind]
        if notes:
            L += ["", f"## {kind[:-1]}", *[f"- {n['time']} " + (f"[{n['unit']}] " if n["unit"] else "") + n["text"] for n in notes]]
    return "\n".join(L)


@contextlib.contextmanager
def plan_lock(plan):
    """Serialise refreshes of one plan so an older render never lands after a newer one."""
    os.makedirs(plan.work, exist_ok=True)
    with open(os.path.join(plan.work, ".lock"), "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def write_view(plan):
    with plan_lock(plan):
        plan = Plan(plan.path)
        view = compute_view(plan)
        return view, patch_plan(plan.path, view["units"])


def cmd_board(plan, write, mode):
    view, changed = write_view(plan) if write else (compute_view(plan), False)
    print({"log": render_log, "takeover": render_takeover}.get(mode, render_board)(view))
    if write:
        print(f"ok Status {'written' if changed else 'unchanged'} · {plan.path}")


def cmd_refresh(root):
    """Hook entry: refresh every plan whose docs/plans/<plan>.work/ exists under root. Never fails the hook."""
    for work in sorted(glob.glob(os.path.join(root, "docs", "plans", "*.work"))):
        path = work[:-len(".work")] + ".md"
        try:
            os.path.isfile(path) and write_view(Plan(path))
        except (SystemExit, Exception) as e:
            print(f"bees-status refresh: {path}: {e}", file=sys.stderr)


def main(argv):
    p = argparse.ArgumentParser(prog="bees-status")
    p.add_argument("--plan", default=os.environ.get("BEES_PLAN"))
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("capture-bee")
    s.add_argument("-u", "--unit", action="append", default=[]); s.add_argument("--role", required=True); s.add_argument("--ctx", required=True)
    s = sub.add_parser("round-out")
    s.add_argument("-u", "--unit", action="append", default=[]); s.add_argument("--role", required=True); s.add_argument("-o", required=True)
    s = sub.add_parser("note")
    s.add_argument("args", nargs="+")
    s = sub.add_parser("refresh")
    s.add_argument("--root", default=os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
    s = sub.add_parser("show")
    s.add_argument("--write", action="store_true")
    mode = s.add_mutually_exclusive_group()
    mode.add_argument("--log", action="store_const", const="log", dest="mode")
    mode.add_argument("--takeover", action="store_const", const="takeover", dest="mode")
    a = p.parse_args(argv)
    if a.cmd == "round-out":
        return print(round_out(a.role, a.unit, a.o)[1])
    if a.cmd == "refresh":
        return cmd_refresh(a.root)
    plan = Plan(a.plan or die("--plan <plan.md> (or BEES_PLAN) is required"))
    if a.cmd == "capture-bee":
        return cmd_capture_bee(plan, a.unit, a.role, a.ctx)
    if a.cmd == "note":
        return cmd_note(plan, a.args)
    if a.cmd == "show":
        return cmd_board(plan, a.write, a.mode)


if __name__ == "__main__":
    main(sys.argv[1:])
