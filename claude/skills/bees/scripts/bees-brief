#!/usr/bin/env python3
"""Assemble a Claude bee's brief from the unit-specific lines on stdin and the verbatim templates.

  bees-brief --plan <plan.md> --units DR-02,DR-01 --kind impl [--round N]
  bees-brief --plan <plan.md> --units GATE-1 --kind run < slot-sha-commands
  bees-brief --work <plan.work> --units DR-02-fix1 --kind fix < fixes-filter-review-or-gate
  bees-brief --plan <plan.md> --units STEP-07 --kind plan-expand < planner-lines
  bees-brief --work <plan.work> --units Q-03 --kind plan-brief < planner-lines
             [--include <file> --set 'lane=lane-1' --set 'task branch=…' …] < unit-lines

Writes <plan>.work/brief-<units>-<kind>-r<N>.txt and prints its path and the hand-off line. The
brief is: stdin, the units line (BEES order), a pointer to each unit's plan section, each --include
with its <placeholders> filled by --set, the role's standing rules with the shared reading rules
after their first sentence, and its return contract with the report path. --work <dir> replaces
--plan in light mode, where there is no plan to point at.
--kind run runs the commands stdin names (slot, target SHA, commands): no plan section, only
codex-implementor's run contract, the one a codex run reads.
--kind fix and --kind recheck take --work only, since a fix unit has no plan section. A fix's stdin
needs Fixes: and Filter: lines and Review: (the review report and finding ids; the original item's
filter) or Gate: (the gate evidence, tested SHA and failing checks; the repair's verification
filter). A gate repair of unknown cause is a diagnosis first (--kind advise or a bee-opus-medium
diagnosis); its recheck names the same gate evidence.
--kind advise asks an advisor a question meant for the owner: advisor rules, no return contract.
--kind plan-brief drafts the plan's brief (usage, architecture, and Outcome, Right, Wrong per item)
(plan-brief needs no plan file); --kind plan-expand expands all of one plan's items under the P-03 budget. Both are the read-only
planner: its standing rules plus the stage's block from templates/planner-<stage>.txt.
Exit 1 on a missing template, an existing brief or report (rounds are never overwritten, and two
concurrent reviews never share a report), an unfilled placeholder in an include, a --set that
fills nothing, --plan for fix or recheck, or a fix brief missing a label.
"""
import argparse, pathlib, re, shlex, sys

TEMPLATES = pathlib.Path(__file__).resolve().parent.parent / "templates"
RUN_CONTRACT = TEMPLATES.parent.parent / "codex-implementor" / "templates" / "run-contract.md"
ROLE = {"impl": "implementor", "fix": "implementor", "review": "reviewer", "recheck": "reviewer",
        "advise": "advisor", "run": "runner", "plan-brief": "planner", "plan-expand": "planner"}
WORK_ONLY = {"fix", "recheck"}
COMMAND_ROLES = {"implementor", "planner"}
STAGE_BLOCK = {"plan-brief": "planner-brief.txt", "plan-expand": "planner-expand.txt"}
PLACEHOLDER = re.compile(r"<([a-z][a-z -]*)>")


def fail(msg):
    sys.exit(f"bees-brief: {msg}")


def read(path):
    try:
        return pathlib.Path(path).read_text()
    except OSError as e:
        fail(f"{path}: {e.strerror}")


SPEC = {
    "implementor": "Spec: read each unit's section in {plan} and follow it as written: start "
                   "from the files and symbols its Today and Approach name, and run the `--filter` its "
                   "Tests field names, narrowed to your piece's classes when this brief names a piece; "
                   "its acceptance holds unless this brief overrides it:",
    "reviewer": "Spec: each unit's section in {plan} is the acceptance the diff is reviewed against:",
    "advisor": "Context: each unit's section in {plan}; decide the question above, never implement:",
    "plan-brief": "Draft: each unit's section in {plan} is the row or item you draft the brief for, read-only:",
    "plan-expand": "Expand: each unit's section in {plan} is an item you expand, read-only:",
}


def spec_lines(plan, units, role, kind):
    return [SPEC.get(kind, SPEC.get(role)).format(plan=plan)] + \
           [f"  sed -En '/^### {u} ·/,/^#{{1,3}} /p' {shlex.quote(str(plan))}" for u in units]


def has_label(text, label):
    return re.search(rf"^{label}:", text, re.M)


def missing_fix_labels(text):
    missing = [f"{l}:" for l in ("Fixes", "Filter") if not has_label(text, l)]
    return missing + ([] if has_label(text, "Review") or has_label(text, "Gate") else ["Review: or Gate:"])


def standing_rules(role):
    rules = read(TEMPLATES / f"standing-rules-{role}.txt")
    reading, filter_output = read(TEMPLATES / "standing-rules-reading.txt").split("\n\n")
    first, rest = re.split(r"(?<=\.)\n", rules, maxsplit=1)
    shared = reading + ("\n" + filter_output.strip() if role in COMMAND_ROLES else "")
    return f"{first}\n{shared}\n{rest}"


def fill(text, values, used):
    def sub(m):
        if m.group(1) in values:
            used.add(m.group(1))
            return values[m.group(1)]
        return m.group(0)
    return PLACEHOLDER.sub(sub, text)


ap = argparse.ArgumentParser()
where = ap.add_mutually_exclusive_group(required=True)
where.add_argument("--plan", type=pathlib.Path)
where.add_argument("--work", type=pathlib.Path)
ap.add_argument("--units", required=True)
ap.add_argument("--kind", required=True, choices=ROLE)
ap.add_argument("--round", type=int, default=1)
ap.add_argument("--include", action="append", default=[])
ap.add_argument("--set", action="append", default=[], metavar="NAME=VALUE")
a = ap.parse_args()

units = a.units.split(",")
if "" in units or len(set(units)) != len(units):
    fail("--units takes distinct comma-separated unit IDs")
if a.round < 1:
    fail("--round starts at 1")
if a.plan and a.kind in WORK_ONLY:
    fail(f"--kind {a.kind} takes --work <plan>.work, not --plan: a fix unit has no plan section")
if a.plan and a.kind != "run":
    plan_text = read(a.plan)
    missing = [u for u in units if not re.search(rf"^### {re.escape(u)} · ", plan_text, re.M)]
    if missing:
        fail(f"{a.plan}: no '### <ID> · ' section for {', '.join(missing)}")
role = ROLE[a.kind]
work = (a.work or a.plan.with_suffix(".work")).resolve()
name = f"{'_'.join(units)}-{a.kind}-r{a.round}"
brief, report = work / f"brief-{name}.txt", work / f"report-{name}.md"
if brief.exists():
    fail(f"{brief} exists; a new round takes the next --round")
if report.exists():
    fail(f"{report} exists; a new round takes the next --round, a piece or fix unit its own --units")

body = sys.stdin.read().strip()
if not body:
    fail("no unit lines on stdin (piece, decisions, conflicts)")
if a.kind == "fix" and missing_fix_labels(body):
    fail(f"--kind fix needs {', '.join(missing_fix_labels(body))} on stdin")

values = dict(s.split("=", 1) for s in a.set if "=" in s)
if len(values) != len(a.set):
    fail("--set takes NAME=VALUE")
used = set()
bees = "" if role == "advisor" else " — your BEES line has one entry per unit, in this order"
parts = [body, f"Units: {', '.join(units)}{bees}."]
if a.plan and a.kind != "run":
    parts.append("\n".join(spec_lines(a.plan.resolve(), units, role, a.kind)))
for inc in a.include:
    text = fill(read(inc), values, used)
    left = sorted(set(PLACEHOLDER.findall(text)))
    if left:
        fail(f"{inc}: unfilled {', '.join(f'<{p}>' for p in left)}; pass --set for each")
    parts.append(text.strip())
if set(values) - used:
    fail(f"--set filled nothing: {', '.join(sorted(set(values) - used))}")
if a.kind in STAGE_BLOCK:
    parts.append(read(TEMPLATES / STAGE_BLOCK[a.kind]).strip())
if role == "runner":
    parts.append(read(RUN_CONTRACT).strip())
else:
    parts.append(standing_rules(role).replace("<report>", shlex.quote(str(report))).strip())
if role not in ("advisor", "runner"):
    parts.append(read(TEMPLATES / f"return-{role}.txt").replace("<report>", shlex.quote(str(report))).strip())

work.mkdir(parents=True, exist_ok=True)
brief.write_text("\n\n".join(parts) + "\n")
print(f"{brief} · {len(brief.read_text().splitlines())} lines")
print(f"Hand-off: Read {brief} and do what it says.")
