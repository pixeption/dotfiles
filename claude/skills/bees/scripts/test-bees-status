with open(os.path.join(RF[:-3] + ".work", ".lock"), "w") as held:
    fcntl.flock(held, fcntl.LOCK_EX)
    run("--plan", RF, "note", "V1", "accept: synthetic")
    waiting = subprocess.Popen([TOOL, "--plan", RF, "show", "--write"], stdout=subprocess.DEVNULL)
    time.sleep(0.5)
    check(waiting.poll() is None and cell(RF, "V1") == "🔵", "show --write waits on the plan's lock")
    write(RF, read(RF).replace("| item V1 |", "| item V1 renamed |"))
waiting.wait()
check(cell(RF, "V1") == "✅", "and writes once the lock is released")
check("| item V1 renamed |" in read(RF), "reading the plan inside the lock keeps an edit made while waiting")
racers = [subprocess.Popen([TOOL, "--plan", RF, "show", "--write"], stdout=subprocess.DEVNULL) for _ in range(6)]
check(all(p.wait() == 0 for p in racers), "concurrent show --write all succeed")
check(bs.Plan(RF).units["V1"]["status"] == "✅" and read(RF).count("### V1 · item V1 **✅ Done") == 1, "and leave one intact plan")

