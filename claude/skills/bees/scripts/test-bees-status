# ---------- GAP-02: codex-usage names windows by length and refuses a stale snapshot ----------

USAGE = os.path.join(HERE, "codex-usage")


def usage_with(rate_limits, age_min=5):
    home = os.path.join(T, f"codex-home-{passed}")
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(time.time() - age_min * 60))
    write(os.path.join(home, "sessions/2026/01/01/rollout-x.jsonl"),
          json.dumps({"timestamp": stamp, "payload": {"type": "token_count", "rate_limits": rate_limits}}) + "\n")
    return subprocess.run([USAGE], capture_output=True, text=True, env={**os.environ, "CODEX_HOME": home})


later = int(time.time()) + 3 * 86400
weekly_only = {"primary": {"used_percent": 37.0, "window_minutes": 10080, "resets_at": later}, "secondary": None, "plan_type": "pro"}
r = usage_with(weekly_only)
check(r.returncode == 0 and r.stdout.startswith("weekly: 37% used") and "5h" not in r.stdout and "ROUTE: codex ok" in r.stdout,
      f"a weekly-only plan routes on the weekly window: {r.stdout}")
r = usage_with({**weekly_only, "primary": {**weekly_only["primary"], "used_percent": 93.0}})
check(r.returncode == 1 and "ROUTE: Claude" in r.stdout, "a weekly window over 90% routes to Claude")
both = {"primary": {"used_percent": 85.0, "window_minutes": 300, "resets_at": int(time.time()) + 3600},
        "secondary": {"used_percent": 10.0, "window_minutes": 10080, "resets_at": later}, "plan_type": "plus"}
r = usage_with(both)
check(r.returncode == 1 and r.stdout.startswith("5h: 85% used") and "weekly: 10% used" in r.stdout, f"a 5-hour window still counts: {r.stdout}")
r = usage_with(weekly_only, age_min=600)
check(r.returncode == 2 and "(STALE)" in r.stdout and "ROUTE: unknown" in r.stdout and "codex ok" not in r.stdout,
      f"a stale snapshot never routes: {r.stdout}")


# ---------- GAP-01/06/07/08/10: preflight, failed rounds, the final message, bees-watch ----------

import socket
SCRIPTS = os.path.expanduser("~/.claude/skills/codex-implementor/scripts")
PREFLIGHT = os.path.join(SCRIPTS, "opencode-preflight")
WATCH = os.path.join(HERE, "bees-watch")
FAKE = os.path.join(T, "fake-opencode-server.py")
write(FAKE, """import http.server, json, sys, urllib.parse
fixture, port = sys.argv[1], int(sys.argv[-1])
class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        url = urllib.parse.urlparse(self.path)
        directory = urllib.parse.parse_qs(url.query).get("directory")
        fx = json.load(open(fixture))
        body = fx.get(f"{url.path}?directory={directory[0]}") if directory else None
        body = fx.get(url.path) if body is None else body
        self.send_response(200 if body is not None else 404); self.end_headers()
        self.wfile.write(json.dumps(body).encode())
    def do_POST(self):
        with open(fixture + ".posts", "a") as f:
            f.write(urllib.parse.unquote(self.path) + "\\n")
        self.send_response(200); self.end_headers(); self.wfile.write(b"true")
    def log_message(self, *a): pass
http.server.HTTPServer(("127.0.0.1", port), H).serve_forever()
""")
fake_bin = os.path.join(T, "fake-bin")
write(os.path.join(fake_bin, "opencode"), f"""#!/usr/bin/env bash
case "$1" in
  serve) [ -f "$FAKE_FIXTURE.after" ] && cp "$FAKE_FIXTURE.after" "$FAKE_FIXTURE"
         exec python3 {FAKE} "$FAKE_FIXTURE" opencode serve --port "$3" ;;
  run) cat "$FAKE_RUN_LOG" ;;
esac
""")
os.chmod(os.path.join(fake_bin, "opencode"), 0o755)
with socket.socket() as s_:
    s_.bind(("127.0.0.1", 0))
    PORT = s_.getsockname()[1]
URL = f"http://127.0.0.1:{PORT}"
FIX = os.path.join(T, "fixture.json")
good = {"/config": {"permission": {"external_directory": {"*": "deny", T + "/**": "allow"}},
                    "agent": {"review-discovery": {"permission": {"edit": "deny"}}}},
        "/config/providers": {"providers": [{"id": "openai", "models": {"gpt-6-luna": {}, "gpt-6-sol": {}}}]},
        "/session/status": {}, "/permission": []}
stale_catalogue = {**good, "/config/providers": {"providers": [{"id": "openai", "models": {"gpt-5.6-luna": {}}}]}}
fenv = {**os.environ, "PATH": fake_bin + os.pathsep + os.environ["PATH"], "FAKE_FIXTURE": FIX}


def serve(fixture):
    write(FIX, json.dumps(fixture))
    proc = subprocess.Popen([os.path.join(fake_bin, "opencode"), "serve", "--port", str(PORT)], env=fenv)
    for _ in range(50):
        try:
            with socket.create_connection(("127.0.0.1", PORT), timeout=0.2):
                return proc
        except OSError:
            time.sleep(0.1)
    sys.exit("FAIL: fake server did not start")


def preflight(*extra, plan=RF):
    return subprocess.run([PREFLIGHT, "--url", URL, "--port", str(PORT), "-C", CODE, "--plan", plan, *extra],
                          capture_output=True, text=True, env=fenv)


server = serve(good)
atexit.register(lambda: subprocess.run(["pkill", "-f", f"opencode serve --port {PORT}( |$)"]))
check(preflight("-m", "openai/gpt-6-luna").returncode == 0, "preflight passes a fenced server listing the model")
r = preflight("-m", "openai/gpt-6-luna", "--no-restart", plan=MR)
check(r.returncode == 0, f"repos under the fence pass: {r.stderr}")
write(FIX, json.dumps({**good, "/config": {"permission": {"external_directory": {"*": "deny", CODE + "/**": "allow"}}}}))
r = preflight("-m", "openai/gpt-6-luna", "--no-restart")
check(r.returncode == 1 and f"outside the live fence: {PLANS}" in r.stderr, f"the plan's repo outside the fence is named: {r.stderr}")
write(FIX, json.dumps({**good, "/config": {}}))
check("no permission fence" in preflight("-m", "openai/gpt-6-luna", "--no-restart").stderr, "a fenceless server is refused")
write(FIX, json.dumps({**stale_catalogue, "/session/status": {"ses_other": {"type": "busy"}}}))
r = preflight("-m", "openai/gpt-6-luna")
check(r.returncode == 1 and "not in /config/providers" in r.stderr and "a session is busy" in r.stderr and server.poll() is None,
      f"a busy server with a stale catalogue is refused, never restarted: {r.stderr}")
write(FIX, json.dumps(stale_catalogue))
write(FIX + ".after", json.dumps(good))
r = preflight("-m", "openai/gpt-6-luna")
check(r.returncode == 0 and "restarting the idle server" in r.stderr, f"an idle server with a stale catalogue is restarted: {r.stderr}")
server.wait(timeout=5)
check(server.returncode is not None, "and the old server is gone")
os.remove(FIX + ".after")

OI = os.path.join(SCRIPTS, "opencode-implement")
OR = os.path.expanduser("~/.claude/skills/codex-review/scripts/opencode-review")
events = lambda *evs: "\n".join(json.dumps({"sessionID": "ses_fake", **e}) for e in evs) + "\n"
step = lambda n: [{"type": "step_start"}, {"type": "text", "part": {"messageID": f"msg_{n}", "text": f"narration {n}"}},
                  {"type": "step_finish", "part": {"tokens": {"total": 1000 * n}}}]
final = [{"type": "step_start"}, {"type": "text", "part": {"messageID": "msg_9", "text": "Outcome: Done"}},
         {"type": "text", "part": {"messageID": "msg_9", "text": "BEES: results=V1:done:-"}},
         {"type": "step_finish", "part": {"tokens": {"total": 9000}}}]
run_log = os.path.join(T, "run.log")


def wrapper(tool, log, unit="V1"):
    write(run_log, log)
    return subprocess.run([tool, "--url", URL, "--port", str(PORT), "-C", CODE, "-p", prompt, "-u", unit, "-o", RF[:-3] + ".work"],
                          capture_output=True, text=True, env={**fenv, "FAKE_RUN_LOG": run_log})


r = wrapper(OI, events(*step(1), *step(2), *final))
out_ok = r.stderr.split(" done -> ")[1].split(" ")[0]
check(r.returncode == 0 and read(out_ok) == "Outcome: Done\nBEES: results=V1:done:-\n", f"the out-file is the final message only: {read(out_ok)!r}")
check(json.loads(read(out_ok + ".usage"))["context_tokens"] == 9000 and os.path.exists(out_ok + ".pid"), "usage and pid are recorded")
err = {"type": "error", "error": {"name": "UnknownError", "data": {"message": "Unexpected server error.", "ref": "err_f9b1"}}}
r = wrapper(OI, events(err))
out_err = r.stderr.split(" done -> ")[1].split(" ")[0]
body = read(out_err)
check(r.returncode == 1 and body.startswith("Blocked: opencode UnknownError (err_f9b1): Unexpected server error.")
      and body.rstrip().endswith("BEES: results=V1:blocked:-"), f"an error event blocks the round and exits 1: {body!r}")
check(bs.parse_bees("impl", body, ["V1"], bs.Plan(RF).units)[1] is None, "the blocked out-file is a valid result")
r = wrapper(OI, events({"type": "step_start"}, {"type": "step_finish", "part": {"tokens": {"total": 5}}}))
out_empty = r.stderr.split(" done -> ")[1].split(" ")[0]
check(r.returncode == 1 and read(out_empty).startswith("Blocked: the round ended without a final message"), "no final message blocks the round")
w = subprocess.run([WATCH, "--url", URL, out_ok, out_err], capture_output=True, text=True)
check(w.returncode == 1 and f"{os.path.basename(out_ok)}: finished" in w.stdout and f"{os.path.basename(out_err)}: failed (Blocked: opencode UnknownError" in w.stdout,
      f"bees-watch: finished vs failed: {w.stdout}")
r = wrapper(OR, events(err))
out_rev = os.path.join(RF[:-3] + ".work", sorted(n for n in os.listdir(RF[:-3] + ".work") if n.startswith("review-V1-") and n.endswith(".txt"))[-1])
check(r.returncode == 1 and read(out_rev).startswith("Blocked: opencode UnknownError") and os.path.exists(out_rev + ".usage"),
      f"opencode-review: a failed round is marked and finished: {r.stderr}")
review_final = [{"type": "text", "part": {"messageID": "msg_1", "text": "reading files"}},
                {"type": "text", "part": {"messageID": "msg_2", "text": "BEES: reviews=V1:-\nAPPROVE"}}]
r = wrapper(OR, events(*review_final))
check(r.returncode == 0 and read(r.stderr.split(" done -> ")[1].split(" ")[0]) == "BEES: reviews=V1:-\nAPPROVE\n", "opencode-review keeps only the verdict message")
write(FIX, json.dumps(stale_catalogue))
rounds_in = lambda: [n for n in listing(RF[:-3] + ".work") if ".txt" in n]
before = rounds_in()
r = wrapper(OI, events(*final))
check(r.returncode == 1 and "after restart: model openai/gpt-6-luna is not in /config/providers" in r.stderr and rounds_in() == before,
      "a model the server does not list fails before any round file is written")
write(FIX, json.dumps(good))

WD = os.path.join(T, "watch")
live = os.path.join(WD, "impl-W1-r1.txt")
write(live + ".log", events({"type": "step_start"}, {"type": "tool_use"}))
write(live + ".cwd", CODE)
write(live + ".pid", str(os.getpid()))
at(time.time() - 3600, live + ".log")
dead = os.path.join(WD, "impl-W2-r1.txt")
write(dead + ".log", events({"type": "step_start"}))
write(dead + ".pid", "999999")
busy = os.path.join(WD, "impl-W3-r1.txt")
write(busy + ".log", events({"type": "step_finish"}).replace("ses_fake", "ses_busy"))
write(busy + ".cwd", CODE)
at(time.time() - 3600, busy + ".log")
elsewhere = os.path.join(WD, "impl-W4-r1.txt")
write(elsewhere + ".log", events({"type": "step_finish"}).replace("ses_fake", "ses_w4"))
write(elsewhere + ".cwd", CODE2)
at(time.time() - 3600, elsewhere + ".log")
write(FIX, json.dumps({**good, "/session/status": {"ses_w4": {"type": "busy"}}, f"/session/status?directory={CODE2}": {},
                       f"/session/status?directory={CODE}": {"ses_busy": {"type": "busy"}, "ses_w4": {"type": "busy"}}}))
w = subprocess.run([WATCH, "--url", URL, live, dead, busy, elsewhere], capture_output=True, text=True).stdout
check("impl-W1-r1.txt: running · log grew 60m ago · BUSY (mid-step)" in w and "quiet but BUSY" in w.splitlines()[0],
      f"a live wrapper mid-step is BUSY, not STALE: {w}")
check("impl-W2-r1.txt: DEAD (wrapper exited without .usage)" in w, "a wrapper that died without .usage is DEAD")
check("impl-W3-r1.txt: running · log grew 60m ago · BUSY ·" in w, f"the server's status for the round's directory is read: {w}")
check("impl-W4-r1.txt: running · log grew 60m ago · idle ·" in w and "STALE" in w.splitlines()[-1],
      f"a session BUSY only in another directory's (or the unscoped) status is not used: {w}")


