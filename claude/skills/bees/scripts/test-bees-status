# ---------- GAP-12: a hook refreshes only the plans active in its session ----------

A_ = os.path.join(PLANS, "docs/plans/2026-01-11-active.md")
Q_ = os.path.join(PLANS, "docs/plans/2026-01-12-quiet.md")
for path_, uid in ((A_, "S1"), (Q_, "S2")):
    write(path_, plan_md([(uid, 1, "")]))
    rw_ = os.path.join(path_[:-3] + ".work", f"impl-{uid}-r1.txt")
    write(rw_, f"BEES: results={uid}:blocked:-\n")
    write(rw_ + ".usage", "{}")
    write(os.path.join(path_[:-3] + ".work", "opencode-serve-4096.log"), "server keeps writing")
    for f_ in (path_, rw_, rw_ + ".usage"):
        at(1000, f_)
transcript = os.path.join(T, "transcript.jsonl")
write(transcript, "{}\n")
at(time.time() + 5, os.path.join(A_[:-3] + ".work", "impl-S1-r1.txt.usage"))
hook = lambda payload: subprocess.run([TOOL, "refresh"], input=payload, capture_output=True, text=True,
                                      env={**os.environ, "CLAUDE_PROJECT_DIR": PLANS})
r = hook(json.dumps({"hook_event_name": "Stop", "transcript_path": transcript}))
check(r.returncode == 0 and cell(A_, "S1") == "🔴 blocked", f"a plan with a round from this session is refreshed: {r.stderr}")
check(cell(Q_, "S2") == "☐", "a plan untouched since the session began is left alone, however stale its Status")
write(Q_, read(Q_) + "\nreverted by hand\n")
hook(json.dumps({"hook_event_name": "Stop", "transcript_path": transcript}))
check(cell(Q_, "S2") == "☐", "editing or reverting the plan file alone does not activate it")
hook(json.dumps({"hook_event_name": "Stop", "transcript_path": os.path.join(T, "missing.jsonl")}))
check(cell(Q_, "S2") == "🔴 blocked", "an unreadable payload refreshes every plan")


