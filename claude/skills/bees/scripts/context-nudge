#!/usr/bin/env bash
# PostToolUse hook (bees frontmatter): once the orchestrator's context reaches the threshold, tell
# it once per session to finish the running unit and hand off (bees §10). Reads the transcript's
# last main-chain assistant usage; no reading yet means no nudge, and the next tool call retries.
# Its only write is the per-session marker in $TMPDIR, made after the nudge is emitted.
#   BEES_NUDGE_AT   threshold in tokens (default 200000)
set -uo pipefail
input="$(cat)"
sid="$(jq -r '.session_id // empty' <<<"$input")"
transcript="$(jq -r '.transcript_path // empty' <<<"$input")"
[ -n "$sid" ] && [ -f "$transcript" ] || exit 0
marker="${TMPDIR:-/tmp}/bees-context-nudge-$sid"
[ -e "$marker" ] && exit 0
at="${BEES_NUDGE_AT:-200000}"
ctx="$(tail -n 400 "$transcript" | jq -Rr 'fromjson? | select(.type == "assistant" and (.isSidechain | not)) | .message.usage // empty
  | (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)' 2>/dev/null | tail -1)"
[ -n "$ctx" ] && [ "$ctx" -ge "$at" ] || exit 0
jq -nc --arg k "$((at / 1000))k" '{hookSpecificOutput: {hookEventName: "PostToolUse",
  additionalContext: "Context at \($k): start nothing new, finish the running unit, then hand off per bees §10."}}'
touch "$marker"
