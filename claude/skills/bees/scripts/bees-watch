#!/usr/bin/env bash
# One line per codex round, no tokens spent: is the wrapper log still growing, is the session
# BUSY, is a permission ask waiting, what is the context size. Replaces tailing the .log.
#
#   bees-watch <out-file>...            # the out-file passed to opencode-implement / opencode-review
#   bees-watch --dir <dir>              # every *.log under <dir> whose out-file exists
#   bees-watch ... --stale-min 20       # mark STALE past this age (default 20)
#
# A round is finished once the wrapper wrote .usage; `failed` when its out-file is then empty or
# carries the wrapper's `Blocked:` line; DEAD when the wrapper (<out-file>.pid) exited without
# .usage. BUSY is the server's /session/status for the round's directory (.cwd — the endpoint is
# scoped per directory), or a live wrapper whose last log event is inside a step; an ask waiting is
# read from /permission for that directory too.
# Exit 0 when every round is live or finished, 1 when any is STALE, DEAD, failed or has an ask waiting.
set -uo pipefail
url="http://127.0.0.1:4096"; stale=20; files=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dir) for l in "$2"/*.log; do f="${l%.log}"; [ -e "$f" ] || [ -e "$l" ] && files+=("$f"); done; shift 2 ;;
    --stale-min) stale="$2"; shift 2 ;;
    --url) url="$2"; shift 2 ;;
    -h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) files+=("${1%.log}"); shift ;;
  esac
done
[ "${#files[@]}" -gt 0 ] || { echo "bees-watch: nothing to watch" >&2; exit 2; }

busy_on_server() { curl -sfG "$url/session/status" --data-urlencode "directory=$1" 2>/dev/null |
  jq -e --arg s "$2" '.[$s].type == "busy"' >/dev/null 2>&1; }
asks_waiting() { curl -sfG "$url/permission" --data-urlencode "directory=$1" 2>/dev/null |
  jq -r --arg s "$2" '[.[] | select(.sessionID==$s)] | length' 2>/dev/null || echo 0; }
mid_step() { case "$(tail -n 50 "$1" | jq -Rr 'fromjson? | .type // empty' 2>/dev/null | tail -1)" in
  step_start|tool_use|text|reasoning) return 0 ;; *) return 1 ;; esac; }
bad=0; now=$(date +%s)
for f in "${files[@]}"; do
  log="$f.log"; name="$(basename "$f")"
  [ -f "$log" ] || { echo "$name: no log"; bad=1; continue; }
  age=$(( (now - $(stat -f %m "$log")) / 60 ))
  sid="$(cat "$f.session" 2>/dev/null || jq -Rr 'fromjson? | select(.sessionID) | .sessionID' "$log" 2>/dev/null | head -1)"
  ctx="$(jq -r '.context_tokens // empty' "$f.usage" 2>/dev/null)"
  pid="$(cat "$f.pid" 2>/dev/null)"
  alive=0; [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && alive=1
  blocked="$(grep -m1 '^Blocked: ' "$f" 2>/dev/null | cut -c1-100)"
  if [ -f "$f.usage" ] && [ ! -s "$f" ]; then state="failed (empty out-file)"; bad=1
  elif [ -f "$f.usage" ] && [ -n "$blocked" ]; then state="failed ($blocked)"; bad=1
  elif [ -f "$f.usage" ]; then state="finished"
  elif [ -n "$pid" ] && [ "$alive" = 0 ]; then state="DEAD (wrapper exited without .usage)"; bad=1
  else state="running"; fi
  b="idle"
  if [ "$state" = running ]; then
    if [ -n "$sid" ] && busy_on_server "$(cat "$f.cwd" 2>/dev/null)" "$sid"; then b="BUSY"
    elif [ "$alive" = 1 ] && mid_step "$log"; then b="BUSY (mid-step)"; fi
  fi
  ask="$(asks_waiting "$(cat "$f.cwd" 2>/dev/null)" "$sid")"
  flag=""
  if [ "$ask" != "0" ]; then flag=" · ASK WAITING"; bad=1
  elif [ "$state" = running ] && [ "$age" -ge "$stale" ] && [ "$b" = idle ]; then flag=" · STALE"; bad=1
  elif [ "$state" = running ] && [ "$age" -ge "$stale" ]; then flag=" · quiet but BUSY (long tool call)"; fi
  echo "$name: $state · log grew ${age}m ago · $b · ctx ${ctx:-?} · session ${sid:-?}$flag"
done
exit $bad
