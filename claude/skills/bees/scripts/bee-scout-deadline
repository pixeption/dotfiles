#!/usr/bin/env python3
"""PreToolUse hook (bee-scout frontmatter): deny a scout's tool calls once BEE_SCOUT_DEADLINE seconds
have passed since its first one, so it must report with what it has.

The first call records the start in $TMPDIR, keyed by session and agent; no agent_id means no output.
  BEE_SCOUT_DEADLINE  default 270: the waiting implementor's prompt cache goes cold at 5 idle minutes
"""
import json, os, pathlib, sys, time

hook = json.load(sys.stdin)
sid, agent = hook.get("session_id"), hook.get("agent_id")
if not (sid and agent):
    sys.exit(0)
limit = int(os.environ.get("BEE_SCOUT_DEADLINE", 270))
start = pathlib.Path(os.environ.get("TMPDIR", "/tmp")) / f"bee-scout-deadline-{sid}-{agent}"
if not start.exists():
    start.write_text(f"{time.time()}\n")
if time.time() - float(start.read_text()) < limit:
    sys.exit(0)
print(json.dumps({"hookSpecificOutput": {
    "hookEventName": "PreToolUse", "permissionDecision": "deny",
    "permissionDecisionReason": f"Scout time limit of {limit} s reached: make no more tool calls and "
                                "report now in your return format, `Outcome: Needs diagnosis` if unanswered."}}))
