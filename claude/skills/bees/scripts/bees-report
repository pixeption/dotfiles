#!/usr/bin/env python3
"""Print the lines of a bees report or codex out-file the orchestrator acts on, never the prose.

  bees-report [--finding <IDs>] [--lane <path> --since <sha>] <file>...

Per file: its size, the Outcome, any Blocked/STOP line, unity-suite's count and report lines, the
Verification, Concerns, Blocker, Options and Need-from-orchestrator sections unless they say
none (a heading listing several, like `Resources / Cost / Need from orchestrator`, counts as its
last), each finding's and each non-blocking suggestion's first line, the out-file's `.usage` context,
and the trailing BEES and verdict lines.
--finding MAJ-02,F3 adds each named finding's whole block, its fix included; an id the file lacks
is named as missing. --lane/--since add the lane's commits since <sha> and its dirty files.
Exit 1 when a file is missing or has no BEES line, a named finding is missing, or the lane cannot be
read: the orchestrator's call. See bees reference/briefs.md "Reports".
"""
import argparse, json, re, subprocess, sys

LABELS = ("Outcome", "Findings", "Changes", "Verification", "Resources", "Cost", "Concerns",
          "Suggestions", "Goal", "Discovered", "Blocker", "Tried", "Options", "Need from orchestrator")
LABEL = "|".join(LABELS)
FIELD = re.compile(rf"^(#+\s*|[-*]\s+)?(?:(?:{LABEL})\s*/\s*)*({LABEL})\b")
SHOWN = ("Verification", "Concerns", "Blocker", "Options", "Need from orchestrator")
BULLET = re.compile(r"^(?:[-*]|\d+[.)])\s+")
NEED_NONE = re.compile(r"^[\s:*_-]*(none|nothing|n/?a)?\W*$", re.I)
KEEP = re.compile(r"^(Blocked:|STOP\.|\d+/\d+ passed, |report: .* · finished |BEES: )")
FINDING_ID = re.compile(r"^(?:#+\s*)?[-*\s]*((?:CRIT|MAJ|MIN|NIT)-\d+|F\d+)\b")
VERDICT = ("APPROVE", "CHANGES_REQUIRED")
FINDING_CHARS = 200  # the claim and usually its file:line; --finding prints the whole block


def field_body(lines, i):
    """The text after a field label at lines[i], plus its continuation lines up to the next field."""
    m = FIELD.match(lines[i])
    body = [lines[i][m.end():].lstrip(" :*")] if m else []
    for line in lines[i + 1:]:
        if line.startswith("#") or FIELD.match(line) or KEEP.match(line) or line in VERDICT:
            break
        body.append(line)
    return [b for b in body if b.strip()]


def compact(lines):
    out, seen = [], set()
    for i, line in enumerate(lines):
        m = FIELD.match(line)
        if m and m.group(2) == "Outcome" and "Outcome" not in seen:
            seen.add("Outcome")
            body = field_body(lines, i)
            if body:
                out += ["Outcome: " + " ".join(body[:2])[:240]]
        elif m and m.group(2) in SHOWN:
            body = field_body(lines, i)
            if body and not NEED_NONE.match(" ".join(body)):
                out += [m.group(2) + ":"] + body[:5] + ["… (more in the file)"] * (len(body) > 5)
        elif m and m.group(2) == "Suggestions":
            bullets = [b[:FINDING_CHARS] for b in field_body(lines, i) if BULLET.match(b)]
            if bullets:
                out += ["Suggestions:"] + bullets[:5] + ["… (more in the file)"] * (len(bullets) > 5)
        elif KEEP.match(line) and not line.startswith("BEES: "):
            out.append(line)
    findings = {}
    for line in lines:
        m = FINDING_ID.match(line)
        if m:
            findings.setdefault(m.group(1), line[:FINDING_CHARS])
    out += findings.values()
    out += [l for l in lines if l.startswith("BEES: ")]
    last = next((l for l in reversed(lines) if l), "")
    if last in VERDICT:
        out.append(last)
    return out


def heading_level(raw):
    return len(raw) - len(raw.lstrip("#")) if raw.startswith("#") else 7


def finding_blocks(raw, lines, wanted):
    """Each wanted id's whole block: from its line to the next finding, an equal-or-higher heading,
    a report field, BEES or verdict line. Ids absent from the file come back as missing."""
    out, missing = [], []
    for fid in wanted:
        starts = [i for i, l in enumerate(lines) if (m := FINDING_ID.match(l)) and m.group(1) == fid]
        for i in starts:
            level, end = heading_level(raw[i]), len(lines)
            for j in range(i + 1, len(lines)):
                l, next_level = lines[j], heading_level(raw[j])
                if (FINDING_ID.match(l) or next_level < 7 and next_level <= level or l.startswith("BEES: ")
                        or l in VERDICT or (level == 7 and FIELD.match(l))):
                    end = j
                    break
            out += [raw[k].rstrip() for k in range(i, end)]
            while out and not out[-1]:
                out.pop()
            out.append("")
        missing += [fid] * (not starts)
    return out, missing


def usage_line(path):
    try:
        usage = json.load(open(path + ".usage"))
    except (OSError, ValueError):
        return []
    ctx = usage.get("context_tokens")
    return [f"Context: {ctx:,} tokens (.usage)"] if isinstance(ctx, int) else []


def git(lane, *args):
    r = subprocess.run(["git", "-C", lane, *args], capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError(r.stderr.strip() or f"git {' '.join(args)} exited {r.returncode}")
    return r.stdout.splitlines()


def lane_state(lane, since):
    base = git(lane, "rev-parse", "--verify", "--end-of-options", f"{since}^{{commit}}")[0]
    commits = git(lane, "log", "--oneline", f"{base}..HEAD", "--")
    dirty = git(lane, "status", "--short")
    return ([f"== lane {lane} · {len(commits)} commits since {since}"] + commits
            + [f"dirty: {len(dirty)} files"] + dirty)


ap = argparse.ArgumentParser(usage="bees-report [--finding <IDs>] [--lane <path> --since <sha>] <file>...")
ap.add_argument("--finding", default="", help="comma-separated ids, e.g. MAJ-02,F3")
ap.add_argument("--lane")
ap.add_argument("--since")
ap.add_argument("files", nargs="+")
args = ap.parse_args()
if bool(args.lane) != bool(args.since):
    ap.error("--lane and --since go together")
wanted = [f for f in re.split(r"[,\s]+", args.finding) if f]

rc = 0
for path in args.files:
    try:
        text = open(path, errors="replace").read()
    except OSError as e:
        print(f"== {path}: {e.strerror}"); rc = 1; continue
    raw = text.splitlines()
    lines = [l.strip().replace("**", "") for l in raw]
    print(f"== {path} · {len(lines)} lines · ~{len(text) // 4} tok")
    body = compact(lines)
    print("\n".join(body + usage_line(path)))
    if not any(l.startswith("BEES: ") for l in body):
        print("(no BEES line: malformed report)"); rc = 1
    if wanted:
        blocks, missing = finding_blocks(raw, lines, wanted)
        print("\n".join(["-- findings"] + blocks).rstrip())
        if missing:
            print(f"MISSING: {', '.join(missing)} not in {path}"); rc = 1
if args.lane:
    try:
        print("\n".join(lane_state(args.lane, args.since)))
    except RuntimeError as e:
        print(f"== lane {args.lane}: {e}"); rc = 1
sys.exit(rc)
