#!/usr/bin/env python3
"""Print the lines of a bees report or codex out-file the orchestrator acts on, never the prose.

  bees-report <file>...

Per file: its size, the Outcome, any Blocked/STOP line, unity-suite's count and report lines, the
Verification, Concerns, Blocker, Options and Need-from-orchestrator sections unless they say none, each finding's
and each non-blocking suggestion's first line, and the trailing BEES and verdict lines. Open the file itself only for the detail a decision
needs (bees reference/briefs.md "Reports").
Exit 1 when a file is missing or has no BEES line: a malformed report, the orchestrator's call.
"""
import re, sys

FIELD = re.compile(r"^(#+\s*|[-*]\s+)?(?:Concerns\s*/\s*)?(Outcome|Findings|Changes|Verification|Resources|Cost|Concerns|Suggestions|Goal|Discovered|Blocker|Tried|Options|Need from orchestrator)\b")
SHOWN = ("Verification", "Concerns", "Blocker", "Options", "Need from orchestrator")
BULLET = re.compile(r"^(?:[-*]|\d+[.)])\s+")
NEED_NONE = re.compile(r"^[\s:*_-]*(none|nothing|n/?a)?\W*$", re.I)
KEEP = re.compile(r"^(Blocked:|STOP\.|\d+/\d+ passed, |report: .* · finished |BEES: )")
FINDING_ID = re.compile(r"^(?:#+\s*)?[-*\s]*((?:CRIT|MAJ|MIN|NIT)-\d+|F\d+)\b")
VERDICT = ("APPROVE", "CHANGES_REQUIRED")
FINDING_CHARS = 200  # the claim and usually its file:line; the exact fix stays in the file


def field_body(lines, i):
    """The text after a field label at lines[i], plus its continuation lines up to the next field."""
    m = FIELD.match(lines[i])
    body = [lines[i][m.end():].lstrip(" :*")] if m else []
    for line in lines[i + 1:]:
        if line.startswith("#") or FIELD.match(line) or KEEP.match(line) or line in VERDICT:
            break
        body.append(line)
    return [b for b in body if b.strip()]


def compact(lines):
    out, seen = [], set()
    for i, line in enumerate(lines):
        m = FIELD.match(line)
        if m and m.group(2) == "Outcome" and "Outcome" not in seen:
            seen.add("Outcome")
            body = field_body(lines, i)
            if body:
                out += ["Outcome: " + " ".join(body[:2])[:240]]
        elif m and m.group(2) in SHOWN:
            body = field_body(lines, i)
            if body and not NEED_NONE.match(" ".join(body)):
                out += [m.group(2) + ":"] + body[:5] + ["… (more in the file)"] * (len(body) > 5)
        elif m and m.group(2) == "Suggestions":
            bullets = [b[:FINDING_CHARS] for b in field_body(lines, i) if BULLET.match(b)]
            if bullets:
                out += ["Suggestions:"] + bullets[:5] + ["… (more in the file)"] * (len(bullets) > 5)
        elif KEEP.match(line) and not line.startswith("BEES: "):
            out.append(line)
    findings = {}
    for line in lines:
        m = FINDING_ID.match(line)
        if m:
            findings.setdefault(m.group(1), line[:FINDING_CHARS])
    out += findings.values()
    out += [l for l in lines if l.startswith("BEES: ")]
    last = next((l for l in reversed(lines) if l), "")
    if last in VERDICT:
        out.append(last)
    return out


rc = 0
for path in sys.argv[1:]:
    try:
        text = open(path, errors="replace").read()
    except OSError as e:
        print(f"== {path}: {e.strerror}"); rc = 1; continue
    lines = [l.strip().replace("**", "") for l in text.splitlines()]
    print(f"== {path} · {len(lines)} lines · ~{len(text) // 4} tok")
    body = compact(lines)
    print("\n".join(body))
    if not any(l.startswith("BEES: ") for l in body):
        print("(no BEES line: malformed report)"); rc = 1
sys.exit(rc)
