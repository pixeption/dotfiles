#!/usr/bin/env bash
# Safe runner for a READ-ONLY OpenCode review session (second opinion, never edits), with a
# persistent, HUMAN-ATTACHABLE server and session reuse. Same codex-family MODELS as codex-review
# (openai/gpt-5.6-sol default) but a different harness: the session lives on a long-running
# `opencode serve`, so the review loop continues round after round with NO 30-min resume cliff
# (you apply findings between rounds — that easily exceeds codex's cache TTL), and the owner can
# watch the reasoning live in a TUI.
#
# The edit tool is hard-denied; `review-followup` also denies task. Bash remains enabled and is
# not filesystem-sandboxed, so the review preamble constrains shell use to read-only commands.
# --auto approves read/bash/external-directory prompts so a backgrounded run never blocks.
#
# What it does:
# 1. Ensures one `opencode serve` is up on --port (starts it headless if not) and prints the
#    ATTACH URL:  opencode attach http://127.0.0.1:<port> --dir <repo> [--session <id>]  (/sessions is scoped to --dir)
# 2. Runs one review round against the repo via `--dir`; review-discovery by default,
#    review-followup with --no-subagents, both under --auto.
# 3. Writes ONLY the final answer (findings + verdict) to the out-file; the raw JSONL stream goes
#    to <out-file>.log (a liveness aid, never read it into context).
# 4. Records the session id (<out-file>.session) so later rounds RESUME it (-s). No 30-min TTL.
# 5. Records tokens/cost (<out-file>.usage) via `extract-opencode-usage` (codex-implementor
#    skill) — the shared extractor also used by opencode-implement. It scopes to THIS
#    session's step-finish events, since an unscoped read can pick up a subagent's instead.
#    If the server auto-compacted the session, `.usage` also carries `compacted` and the final
#    stderr line flags it — the review lost the original detail behind a summary at that point.
#
# Usage:
#   opencode-review -C <repo> -p <prompt-file> -o <out-file>
#                   [-m openai/gpt-5.6-sol] [-e medium] [-s <session-id>]
#                   [--port 4096] [--url http://127.0.0.1:4096] [--title <artifact>] [--no-subagents]
#   --no-subagents  use the `review-followup` agent instead of `review-discovery` (both in
#                   ~/.config/opencode/opencode.jsonc); both deny edit, and review-followup also
#                   denies task so later rounds cannot spawn sub-agents.
#   -m  provider/model (default openai/gpt-5.6-sol). -e  effort -> --variant (default medium).
#   -s  resume a session id (from a previous <out-file>.session). No TTL — server-held.
#   --port  server port (default 4096). --url overrides the base URL. --title  TUI session title.
set -euo pipefail

model="openai/gpt-5.6-sol"
effort="medium"
workdir=""
promptfile=""
outfile=""
session=""
port="4096"
url=""
title=""
agent="review-discovery"

while [ $# -gt 0 ]; do
  case "$1" in
    -m|--model)       model="$2"; shift 2 ;;
    -e|--effort)      effort="$2"; shift 2 ;;
    -C|--cd)          workdir="$2"; shift 2 ;;
    -p|--prompt-file) promptfile="$2"; shift 2 ;;
    -o|--out)         outfile="$2"; shift 2 ;;
    -s|--session)     session="$2"; shift 2 ;;
    --port)           port="$2"; shift 2 ;;
    --url)            url="$2"; shift 2 ;;
    --title)          title="$2"; shift 2 ;;
    --no-subagents)   agent="review-followup"; shift ;;
    -h|--help)
      grep '^#' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) echo "opencode-review: unknown arg '$1'" >&2; exit 2 ;;
  esac
done

[ -n "$workdir" ] && [ -d "$workdir" ] || { echo "opencode-review: need -C <existing repo dir>" >&2; exit 2; }
[ -n "$promptfile" ] && [ -f "$promptfile" ] || { echo "opencode-review: need -p <prompt-file>" >&2; exit 2; }
[ -n "$outfile" ] || { echo "opencode-review: need -o <out-file>" >&2; exit 2; }
command -v opencode >/dev/null 2>&1 || { echo "opencode-review: 'opencode' not on PATH" >&2; exit 127; }
command -v jq >/dev/null 2>&1 || { echo "opencode-review: 'jq' not on PATH" >&2; exit 127; }
[ -n "$url" ] || url="http://127.0.0.1:${port}"
[ -n "$title" ] || title="review $(basename "$outfile")"

if ! curl -sf "${url}/config" >/dev/null 2>&1; then
  echo "opencode-review: no server at ${url} — starting one" >&2
  serverlog="${outfile%/*}/opencode-serve-${port}.log"
  nohup opencode serve --port "$port" --hostname 127.0.0.1 >"$serverlog" 2>&1 &
  disown || true
  for _ in $(seq 1 30); do curl -sf "${url}/config" >/dev/null 2>&1 && break; sleep 1; done
  curl -sf "${url}/config" >/dev/null 2>&1 || { echo "opencode-review: server did not come up on ${url}" >&2; exit 1; }
fi
echo "opencode-review: WATCH LIVE ->  opencode attach ${url} --dir ${workdir}   (the TUI lists sessions per --dir; add --session <id> from the .session file to jump straight in)" >&2

claude_docs="$(find "$workdir" -name CLAUDE.md -not -path '*/Library/*' -not -path '*/node_modules/*' 2>/dev/null | sort)"
preamble="You are a READ-ONLY reviewer: raise findings, never edit files. Before reviewing, read ~/.claude/CLAUDE.md, then every CLAUDE.md in this repository (root first, nearer ones apply to their subtree):
$claude_docs
Follow them as user and repository guidance. Skills are available at ~/.claude/skills/<name>/SKILL.md and $workdir/.claude/skills/<name>/SKILL.md; when the task names one or clearly matches one's description, read its SKILL.md completely before acting.

---

"
prompt="$(cat "$promptfile")"
[ -n "$session" ] || prompt="${preamble}${prompt}"
if ! curl -sf "${url}/config" |
  jq -e --arg agent "$agent" '
    .agent[$agent].permission.edit == "deny" and
    ($agent != "review-followup" or .agent[$agent].permission.task == "deny")
  ' >/dev/null; then
  echo "opencode-review: server at ${url} lacks the required ${agent} permissions (started before the config change?); restart opencode serve and rerun" >&2
  exit 1
fi
logfile="${outfile}.log"
sessionfile="${outfile}.session"
usagefile="${outfile}.usage"

session_args=()
[ -n "$session" ] && session_args=(--session "$session")

# The selected agent denies the edit tool; review-followup also denies task. --auto approves the
# read/bash/external prompts, so the preamble must enforce read-only shell use. Keep stdin closed.
opencode run --attach "$url" --dir "$workdir" --agent "$agent" --auto \
  -m "$model" --variant "$effort" --title "$title" \
  --format json "${session_args[@]}" \
  "$prompt" < /dev/null > "$logfile" 2>&1 || true

jq -r 'select(.type=="text") | .part.text' "$logfile" 2>/dev/null > "$outfile" || true
apierr="$(jq -r 'select(.type=="error") | .error.data.message // .error.name' "$logfile" 2>/dev/null | head -1)"
if [ -n "$apierr" ]; then
  echo "opencode-review: FAILED — $apierr; discard the possibly partial answer in $outfile" >&2
  case "$apierr" in *expired*|*401*|*nauthorized*) echo "opencode-review: credential expired -> owner runs \`opencode auth login\` (interactive), then rerun" >&2 ;; esac
  exit 1
fi
if [ ! -s "$outfile" ]; then
  echo "opencode-review: EMPTY ANSWER — no text event in log" >&2
  exit 1
fi
if ! grep -v '^[[:space:]]*$' "$outfile" | tail -n 1 | grep -qE '^[[:space:]]*(APPROVE|CHANGES_REQUIRED)[[:space:]]*$'; then
  echo "opencode-review: WARNING — answer does not end with a verdict line; possibly truncated" >&2
fi
sid="$(jq -r 'select(.sessionID) | .sessionID' "$logfile" 2>/dev/null | head -1 || true)"
[ -n "$sid" ] && printf '%s\n' "$sid" > "$sessionfile"
"$HOME/.claude/skills/codex-implementor/scripts/extract-opencode-usage" "$logfile" "$sid" > "$usagefile" || true

compacted="$(jq -r 'if .compacted then "; COMPACTED (\(if .compacted.auto then "auto" else "manual" end), overflow=\(.compacted.overflow)) — reviewer context before this point is now a summary, not the original source read; consider a fresh session if it seems anchored" else "" end' "$usagefile" 2>/dev/null)"
echo "opencode-review: $model/$effort (read-only) done -> $outfile (findings+verdict); session ${sid:-unknown}${compacted}; usage $usagefile; log $logfile; attach: opencode attach ${url} --dir ${workdir} --session ${sid:-<id>}" >&2
