#!/usr/bin/env bash
# Single source of truth for reading the CURRENT CONTEXT SIZE out of an `opencode run
# --format json` event log. Shared by opencode-implement (this skill) and opencode-review
# (codex-review skill) — both wrap the same OpenCode channel and previously duplicated this
# extraction, unscoped by session. Prints one JSON object to stdout:
#   {"context_tokens":N,"tokens":{...},"cost":N,"compacted":{"auto":bool,"overflow":bool,"tail_start_id":"msg_...","at":epoch_ms}}
# `compacted` is present only if the server auto- or manually compacted this session at some
# point in the log; it is the LAST such event, since only the most recent one still shapes the
# current context. Prints nothing (exit 0) if no step-finish event for that session is found.
#
# WHY `compacted` exists: the server compacts a session on its own once it crosses its overflow
# threshold (observed ~270k tokens for these models), replacing the tail with a summary. The next
# step-finish's `tokens.total` then reports the real, much smaller post-compaction context —
# CORRECT, not a bug — but a caller reading only `context_tokens` cannot tell "genuinely started
# small" from "was ~270k, just got compacted, and everything before tail_start_id is now a
# summary, not the original detail". `opencode run --format json` emits a compaction as an
# ordinary Part event, `{"type":"compaction","sessionID":...,"part":{"type":"compaction",
# "auto":bool,"overflow":bool,"tail_start_id":"msg_..."}}` — verified against real rows in a live
# opencode.db (`part` table) and against the SDK's CompactionPart type — so it is read the same
# way as every other event here, scoped by session id.
#
# WHY tokens.total (via context_tokens): OpenCode's own SessionCompaction.isOverflow — the
# function that decides when the SERVER itself triggers auto-compaction — keys off exactly
# this field on the last completed step, compared against the model's context-window budget.
# It is not a guess; it is what OpenCode's own compaction trigger already treats as "current
# context". `total` isn't in the published @opencode-ai/sdk type but is present on every real
# step-finish event (verified directly against a live opencode.db). The fallback sum covers
# the rare case it's ever absent, matching OpenCode's own fallback formula plus `reasoning`
# (their internal fallback omits it — a minor inconsistency in their code, not a reason to
# copy it here).
#
# WHY scoped by session id (the fix this consolidation makes): an unscoped
# `select(.type=="step_finish")` over the whole log can pick up a SUBAGENT's step-finish
# event instead of the primary session's, if the round used one — silently reporting a much
# smaller context than the one actually being resumed. The session id is already captured
# elsewhere in each caller from this same log's top-level `.sessionID` field; pass it in.
#
# WHY -R + fromjson?, not plain jq input mode: both wrapper's <out-file>.log is stdout AND
# stderr combined; a plain-text line (a warning, a crash trace) is invalid JSON and would
# otherwise abort the whole parse, printing only whatever matched before that line and
# silently discarding a later, more-current step-finish event (verified: it happens, and
# `tail -1` on the ones printed before the abort then returns a STALE reading, not the
# latest). `fromjson?` skips a line that isn't JSON instead of erroring the pipeline.
#
# Usage: extract-opencode-usage <logfile> <session-id>
set -euo pipefail
logfile="${1:?usage: extract-opencode-usage <logfile> <session-id>}"
sid="${2:?usage: extract-opencode-usage <logfile> <session-id>}"

jq -cnR --arg sid "$sid" '
  [inputs | fromjson? | select(.sessionID==$sid)] as $events |
  ($events | map(select(.type=="step_finish")) | last) as $sf |
  ($events | map(select(.type=="compaction")) | last) as $cp |
  if $sf == null then empty else
    {
      context_tokens: ($sf.part.tokens.total //
        (($sf.part.tokens.input // 0) + ($sf.part.tokens.output // 0) + ($sf.part.tokens.reasoning // 0)
          + ($sf.part.tokens.cache.read // 0) + ($sf.part.tokens.cache.write // 0))),
      tokens: $sf.part.tokens,
      cost: $sf.part.cost
    } + (if $cp == null then {} else
      {compacted: {auto: $cp.part.auto, overflow: $cp.part.overflow, tail_start_id: $cp.part.tail_start_id, at: $cp.timestamp}}
    end)
  end
' "$logfile" 2>/dev/null
