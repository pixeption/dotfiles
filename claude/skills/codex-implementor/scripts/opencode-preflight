#!/usr/bin/env python3
"""Check the live OpenCode server before a round is allocated; restart it when that fixes it and
no session is busy. Shared by opencode-implement and opencode-review, and bees §0's setup check.

The server reads ~/.config/opencode/opencode.jsonc and fetches its model catalogue at STARTUP
only, so a long-running server can lack the fence, lack a newly allowed directory, or name no
model the wrapper asks for (a stale catalogue: `ProviderModelNotFoundError`, 2026-09-24).

  opencode-preflight -m <provider/model> -C <dir> [--plan <plan.md>] [--url http://127.0.0.1:4096]
                     [--port 4096] [--serverlog <file>] [--no-restart]

Checks, against the live server:
  fence  /config has a permission.external_directory block
  paths  the plan's repo and every checklist Repo outside -C is allowed by that block, both as
         given and symlink-resolved (-C itself is the session's own directory)
  model  -m is listed by /config/providers
A server that is down is started. A failed check restarts it only when no `opencode run`/`attach`
process names its port and no session in any directory is busy, then checks again; a busy server,
or one whose sessions cannot be listed, is never restarted. Success prints one line naming the
server state, the model and the repos checked against the fence. Exit 0 ok · 1 not fixed · 2 usage.

The fence is evaluated as OpenCode 1.18.32 does (bundled Permission.evaluate / Wildcard.match /
fromConfig): a leading `~/` or `$HOME` becomes the home dir, `*` matches any run of characters
(slashes too), `?` one character, and the LAST matching rule in config order wins (no match: ask).
A file's ask is `<its directory>/*`, from the given path on some tool paths and the canonical one on
others, so a repo passes only when both spellings are allowed.
"""
import argparse, importlib.machinery, importlib.util, json, os, re, subprocess, sys, time, urllib.parse, urllib.request


def say(msg):
    print(f"opencode-preflight: {msg}", file=sys.stderr)


def fail(msg):
    say(msg)
    sys.exit(1)


def get(url, path):
    try:
        with urllib.request.urlopen(url + path, timeout=5) as r:
            return json.load(r)
    except Exception:
        return None


def expand_home(pattern):
    home = os.path.expanduser("~")
    if pattern == "~" or pattern.startswith("~/"):
        return home + pattern[1:]
    return home + pattern[5:] if pattern.startswith("$HOME") else pattern


def wildcard(pattern, text):
    regex = re.escape(expand_home(pattern)).replace(r"\*", ".*").replace(r"\?", ".")
    return re.fullmatch(regex, text, re.S) is not None


def allowed(fence, path):
    """The last fence rule matching `<dir>/*` decides, for the given and the resolved spelling alike."""
    probes = {os.path.join(os.path.abspath(path), "*"), os.path.join(os.path.realpath(path), "*")}
    last_match = lambda probe: next((fence[p] for p in reversed(list(fence)) if wildcard(p, probe)), "ask")
    return all(last_match(probe) == "allow" for probe in probes)


def plan_repos(plan):
    loader = importlib.machinery.SourceFileLoader(
        "bees_status", os.path.expanduser("~/.claude/skills/bees/scripts/bees-status"))
    bs = importlib.util.module_from_spec(importlib.util.spec_from_loader("bees_status", loader))
    loader.exec_module(bs)
    p = bs.Plan(plan)
    return {p.root} | {path for u in p.units.values() for path in u["repo_paths"]}


def outside(workdir, repos):
    inside = lambda path: os.path.realpath(path) == workdir or os.path.realpath(path).startswith(workdir + os.sep)
    return sorted(r for r in repos if not inside(r))


def problems(url, model, workdir, repos):
    config = get(url, "/config")
    if config is None:
        return ["no server"]
    out = []
    fence = (config.get("permission") or {}).get("external_directory")
    if not isinstance(fence, dict):
        out.append("the server has no permission fence (external_directory) — every outside path would be an ask nobody answers")
    else:
        denied = [r for r in outside(workdir, repos) if not allowed(fence, r)]
        if denied:
            out.append(f"outside the live fence: {', '.join(denied)} — allow them in ~/.config/opencode/opencode.jsonc")
    provider, _, name = model.partition("/")
    catalogue = get(url, "/config/providers") or {}
    listed = next((p.get("models", {}) for p in catalogue.get("providers", []) if p.get("id") == provider), {})
    if name not in listed:
        out.append(f"model {model} is not in /config/providers (a stale catalogue, or a wrong id)")
    return out


def session_busy(url):
    """/session/status answers per directory, so every directory with a session is asked; a listing
    or a status that cannot be read counts as busy."""
    sessions = get(url, "/experimental/session?limit=100000")
    if not isinstance(sessions, list):
        return True
    for directory in {s.get("directory") for s in sessions}:
        status = get(url, "/session/status?directory=" + urllib.parse.quote(directory or "", safe=""))
        if not isinstance(status, dict) or any(v.get("type") != "idle" for v in status.values()):
            return True
    return False


def client_attached(port):
    clients = subprocess.run(["pgrep", "-f", f"opencode (run|attach) .*:{port}( |/|$)"], capture_output=True, text=True)
    return clients.returncode != 1


def busy(url, port):
    return client_attached(port) or session_busy(url)


def wait(url, up, seconds):
    for _ in range(seconds):
        if (get(url, "/config") is not None) == up:
            return True
        time.sleep(1)
    return (get(url, "/config") is not None) == up


def start(url, port, serverlog):
    say(f"starting opencode serve on {url}")
    log = open(serverlog, "a") if serverlog else subprocess.DEVNULL
    subprocess.Popen(["opencode", "serve", "--port", port, "--hostname", "127.0.0.1"], stdin=subprocess.DEVNULL,
                     stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    wait(url, True, 30) or fail(f"server did not come up on {url}")


def main():
    a = argparse.ArgumentParser(prog="opencode-preflight")
    a.add_argument("-m", "--model", required=True)
    a.add_argument("-C", "--dir", required=True)
    a.add_argument("--plan")
    a.add_argument("--url")
    a.add_argument("--port", default="4096")
    a.add_argument("--serverlog")
    a.add_argument("--no-restart", action="store_true")
    a = a.parse_args()
    url = a.url or f"http://127.0.0.1:{a.port}"
    workdir = os.path.realpath(a.dir)
    repos = plan_repos(a.plan) if a.plan else set()
    checked = " ".join(outside(workdir, repos)) or "no repo outside -C"
    ok = lambda server: say(f"ok · {url} {server} · model {a.model} listed · fence allows {checked}" + ("" if a.plan else " (no --plan)"))
    server = "running"
    if get(url, "/config") is None:
        start(url, a.port, a.serverlog)
        server = "started"
    found = problems(url, a.model, workdir, repos)
    if not found:
        ok(server)
        return 0
    if a.no_restart or busy(url, a.port):
        for p in found:
            say(p)
        say("not restarting: " + ("--no-restart" if a.no_restart else "a session is busy, its status is unreadable, or a client is attached — let it finish, then re-run"))
        return 1
    say(f"{'; '.join(found)} — restarting the idle server")
    subprocess.run(["pkill", "-f", f"opencode serve --port {a.port}( |$)"])
    wait(url, False, 10) or fail(f"server at {url} did not stop (not started as 'opencode serve --port {a.port}'?) — restart it by hand")
    start(url, a.port, a.serverlog)
    found = problems(url, a.model, workdir, repos)
    for p in found:
        say(f"after restart: {p}")
    if found:
        return 1
    ok("restarted")
    return 0


if __name__ == "__main__":
    sys.exit(main())
