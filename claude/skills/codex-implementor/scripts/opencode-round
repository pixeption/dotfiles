#!/usr/bin/env bash
# Run one `opencode run --attach` round for opencode-implement and opencode-review, watch it, and
# finish its files. Shared so both wrappers fail a round the same way.
#
#   opencode-round --url <url> -C <dir> --role impl|review -o <out-file> [-u <unit>]... -- <opencode run …>
#
# While the run lives, a pending permission ask for its session in -C (both spellings; /permission
# is scoped per directory) is rejected and the run stopped — with the fence loaded, nobody headless
# can answer it; a /permission query or a reject that fails stops the run and aborts its session
# (or the Blocked line says it is still pending and must not be resumed). Afterwards:
# <out-file>.session, the out-file (the final assistant message, via extract-opencode-final), then
# <out-file>.usage, written last because bees-watch reads it as "finished". The round FAILED when an
# ask was rejected or could not be checked, the log has an `error` event, the run exited non-zero,
# there is no final message, the final message's step did not finish with reason `stop`, or (review)
# the answer does not end in APPROVE/CHANGES_REQUIRED. A failed out-file is `Blocked: <reason>`, the
# partial answer without BEES lines, and `BEES: results=<unit>:blocked:-` for every -u (none without
# -u), so a failed review never reads as a verdict.
# Exit 0 finished · 1 failed (stderr says why) · 2 usage.
set -uo pipefail

url=""; workdir=""; role=""; outfile=""; units=()
while [ $# -gt 0 ]; do
  case "$1" in
    --url) url="$2"; shift 2 ;;
    -C)    workdir="$2"; shift 2 ;;
    --role) role="$2"; shift 2 ;;
    -o)    outfile="$2"; shift 2 ;;
    -u)    units+=("$2"); shift 2 ;;
    --)    shift; break ;;
    *) echo "opencode-round: unknown arg '$1'" >&2; exit 2 ;;
  esac
done
[ -n "$url" ] && [ -d "$workdir" ] && [ -n "$outfile" ] && [ $# -gt 0 ] &&
  { [ "$role" = impl ] || [ "$role" = review ]; } || { echo "opencode-round: usage: see the header" >&2; exit 2; }

here="$(dirname "$0")"
logfile="${outfile}.log"
dirs=("$(cd "$workdir" && pwd -L)"); [ "$(cd "$workdir" && pwd -P)" = "${dirs[0]}" ] || dirs+=("$(cd "$workdir" && pwd -P)")

session_id() { jq -Rr 'fromjson? | select(.sessionID) | .sessionID' "$logfile" 2>/dev/null | head -1; }
pending_ask() {
  for d in "${dirs[@]}"; do
    curl -sfG "${url}/permission" --data-urlencode "directory=$d" 2>/dev/null |
      jq -c --arg s "$1" --arg d "$d" 'if type == "array" then .[] | select(.sessionID == $s) | . + {directory: $d}
        else error("not a list") end' 2>/dev/null || return 1
  done
}
post_ok() { [ "$(curl -sf -X POST "$@" 2>/dev/null)" = true ]; }
reject() {
  post_ok "${url}/permission/$(jq -r '"\(.id)/reply?directory=\(.directory | @uri)"' <<<"$1")" \
    -H 'content-type: application/json' -d '{"reply":"reject","message":"headless run: outside the fence"}'
}
abort_session() {
  for d in "${dirs[@]}"; do post_ok -G "${url}/session/$1/abort" --data-urlencode "directory=$d" && return 0; done
  return 1
}

"$@" < /dev/null > "$logfile" 2>&1 &
runpid=$!
blocked=""; unsafe=""
tick=0
while kill -0 "$runpid" 2>/dev/null; do
  sleep 1; tick=$((tick + 1)); [ $((tick % ${OPENCODE_ROUND_POLL:-15})) = 0 ] || continue
  sid="$(session_id)"; [ -n "$sid" ] || continue
  if ! ask="$(pending_ask "$sid")"; then
    unsafe="Could not read /permission for session ${sid}"
  else
    [ -n "$ask" ] || continue
    ask="${ask%%$'\n'*}"
    blocked="Blocked: permission $(jq -r .permission <<<"$ask") $(jq -c .patterns <<<"$ask") — outside the fence in ~/.config/opencode/opencode.jsonc; widen it or re-brief."
    reject "$ask" || unsafe="Rejecting the ask failed"
  fi
  if [ -n "$unsafe" ]; then
    abort_session "$sid" && unsafe="$unsafe; session aborted" || unsafe="$unsafe; session ${sid} is still pending on the server — do not resume it"
    blocked="${blocked:-Blocked:} $unsafe."
  fi
  kill "$runpid" 2>/dev/null
done
wait "$runpid"; status=$?

sid="$(session_id)"
[ -n "$sid" ] && printf '%s\n' "$sid" > "${outfile}.session"
"$here/extract-opencode-final" "$logfile" "$sid" > "$outfile" 2>/dev/null
apierr="$(jq -rR 'fromjson? | select(.type=="error") | .error | "\(.name // "error")\(if .data.ref then " (\(.data.ref))" else "" end): \(.data.message // "")"' "$logfile" 2>/dev/null | head -1)"
final_step_stopped() {
  jq -enR --arg s "$sid" '[inputs | fromjson? | select(.sessionID == $s)] as $e |
    ([$e[] | select(.type == "text")] | last | .part.messageID) as $msg |
    ([$e[] | select(.type == "step_finish")] | last | .part) as $step |
    $msg != null and $step.messageID == $msg and $step.reason == "stop"' "$logfile" >/dev/null 2>&1
}
ends_in_verdict() { grep -v '^[[:space:]]*$' "$outfile" | tail -n 1 | grep -qE '^[[:space:]]*(APPROVE|CHANGES_REQUIRED)[[:space:]]*$'; }

[ -z "$blocked" ] && [ -n "$apierr" ] && blocked="Blocked: opencode ${apierr}"
[ -z "$blocked" ] && [ "$status" != 0 ] && blocked="Blocked: opencode run exited ${status}"
[ -z "$blocked" ] && [ ! -s "$outfile" ] && blocked="Blocked: the round ended without a final message"
[ -z "$blocked" ] && ! final_step_stopped && blocked="Blocked: the final message's step did not finish (no step_finish with reason stop)"
[ -z "$blocked" ] && [ "$role" = review ] && ! ends_in_verdict && blocked="Blocked: the answer does not end in APPROVE or CHANGES_REQUIRED (truncated?)"
if [ -n "$blocked" ]; then
  blocked="$blocked (log: ${logfile})"
  results=""; [ "${#units[@]}" = 0 ] || results="$(printf '%s:blocked:-;' "${units[@]}")"
  partial="$(grep -v '^BEES:' "$outfile")"
  printf '%s\n\n%s%s\n' "$blocked" "$partial" "${results:+${partial:+$'\n\n'}BEES: results=${results%;}}" > "$outfile"
  echo "opencode-round: $blocked" >&2
fi
"$here/extract-opencode-usage" "$logfile" "$sid" > "${outfile}.usage"
[ -z "$blocked" ]
