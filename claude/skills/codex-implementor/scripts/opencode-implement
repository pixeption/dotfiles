#!/usr/bin/env bash
# Safe runner for an OpenCode IMPLEMENTATION session (opencode edits files), with a persistent,
# HUMAN-ATTACHABLE server and session reuse. Same codex-family MODELS as codex-implement
# (openai/gpt-6-luna, sol, ...) but a different harness: the session lives on a long-running
# `opencode serve`, so the orchestrator drives it round after round with NO 30-min resume cliff,
# and the owner can watch/steer the SAME session live in a TUI.
#
# What it does:
# 1. Ensures one `opencode serve` is up on --port (starts it headless if not) and prints the
#    ATTACH URL so the owner can run:  opencode attach http://127.0.0.1:<port> --dir <workdir> [--session <id>]
#    (the TUI scopes /sessions to --dir; attached from another directory the session is invisible)
# 2. Runs one round via `--dir` against ANY directory: a git worktree (the default — the
#    orchestrator reviews a diff and merges deliberately) or the REAL project checkout for an
#    in-place editor-drive unit (brief names the unity-cli skill; the unit holds that project's
#    slot). OpenCode has no OS sandbox; --auto approves everything not denied, and the fence is
#    the `permission` block in ~/.config/opencode/opencode.jsonc (external_directory deny-by-default,
#    forbidden git commands denied).
# 3. Writes ONLY the final assistant message (the last message's text, via `extract-opencode-final`)
#    to the out-file; the raw JSONL event stream, narration included, goes to <out-file>.log (a
#    liveness aid, never read it into context). <out-file>.pid holds this wrapper's PID
#    (bees-watch reads a dead PID without .usage as DEAD).
# 4. Records the session id (<out-file>.session) so a follow-up round RESUMES it (-s). The server
#    keeps the session; its prompt cache is warm for 30 min, and it is PINNED to the directory it
#    was created in — a resume with a different -C is refused here (it would hit the
#    external-directory fence and ask a human instead of running).
# 5. Records tokens/cost (<out-file>.usage) via `extract-opencode-usage` (this dir) — the shared
#    extractor also used by opencode-review. It scopes to THIS session's step-finish events
#    (a subagent's would otherwise contaminate an unscoped read) and reports `context_tokens`,
#    the figure the bees budget rule reads (continue < 120k, none ≥ 200k). If the server
#    auto-compacted the session, `.usage` also carries `compacted` and the final stderr line
#    flags it — `context_tokens` is the real post-compaction size, but history before it is now
#    a summary, not the original detail (see extract-opencode-usage for the event shape).
# 6. Runs `opencode-preflight` before any round file is written: the live server must carry the
#    fence, allow every --repo outside -C, and list -m in /config/providers. The server reads
#    opencode.jsonc and its model catalogue at STARTUP only — a server older than the fence makes
#    every external path an "ask" nobody answers (a round waited a whole night, 2026-09-20), and a
#    stale catalogue fails the round's first step (2026-09-24). An idle server is restarted.
# 7. Runs the round through `opencode-round` (this dir, shared with opencode-review): a pending
#    permission ask for this session means the fence did not cover it, so it is rejected and the run
#    stopped. Local HTTP only, no tokens.
# 8. A round that did not finish — a permission ask, an `error` event, a non-zero `opencode run`
#    exit, no final message, or a final step that did not stop — gets `Blocked: <reason>` and
#    `BEES: results=<unit>:blocked:-` for each unit in its out-file, and the wrapper exits 1, so
#    the notification never reads it as done.
#
# A NEW session (no -s) gets a preamble prepended: read ~/.claude/CLAUDE.md and every CLAUDE.md in
# the worktree, and the skills folders — so opencode loads the same guidance a Claude/codex session
# does. A resumed session already has that in context.
#
# In a worktree opencode cannot run Unity or your build (no Library); validate the diff yourself.
# In place it drives the live editor through the `unity` CLI and verifies itself.
#
# Usage:
#   opencode-implement -C <worktree|real checkout> -p <prompt-file> -o <out-file> [-u <unit>]... [--repo <dir>]...
#                      [-m openai/gpt-6-luna] [-e max] [-s <session-id>]
#                      [--port 4096] [--url http://127.0.0.1:4096] [--title <unit>]
#   -o  the out-file, taken verbatim (its directory is created); refused if it already holds a round.
#       Under bees: docs/plans/<plan>.work/impl-<unit>-r<N>.txt.
#   -u  optional unit label(s) for the failed-round `BEES: results=` line (repeatable).
#   --repo  a sibling repo the unit touches outside -C; preflight checks the fence allows it (repeatable).
#   -m  provider/model (default openai/gpt-6-luna). sol: openai/gpt-6-sol.
#   -e  reasoning effort -> opencode --variant (minimal|low|medium|high|max). Default: max.
#   -s  resume a session id (from a previous <out-file>.session). Same -C as the session's
#       directory only; cache warm 30 min, one cold turn after that.
#   --port  server port (default 4096). --url overrides the full base URL.
#   --title session title shown in the attach TUI (default: out-file basename).
set -euo pipefail

model="openai/gpt-6-luna"
effort="max"
workdir=""
promptfile=""
outfile=""
session=""
port="4096"
url=""
title=""
units=()
repos=()

while [ $# -gt 0 ]; do
  case "$1" in
    -m|--model)       model="$2"; shift 2 ;;
    -e|--effort)      effort="$2"; shift 2 ;;
    -C|--cd)          workdir="$2"; shift 2 ;;
    -p|--prompt-file) promptfile="$2"; shift 2 ;;
    -o|--out)         outfile="$2"; shift 2 ;;
    -u|--unit)        units+=(-u "$2"); shift 2 ;;
    --repo)           repos+=(--repo "$2"); shift 2 ;;
    -s|--session)     session="$2"; shift 2 ;;
    --port)           port="$2"; shift 2 ;;
    --url)            url="$2"; shift 2 ;;
    --title)          title="$2"; shift 2 ;;
    -h|--help)
      grep '^#' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) echo "opencode-implement: unknown arg '$1'" >&2; exit 2 ;;
  esac
done

[ -n "$workdir" ] && [ -d "$workdir" ] || { echo "opencode-implement: need -C <existing worktree>" >&2; exit 2; }
[ -n "$promptfile" ] && [ -f "$promptfile" ] || { echo "opencode-implement: need -p <prompt-file>" >&2; exit 2; }
[ -n "$outfile" ] || { echo "opencode-implement: need -o <out-file>" >&2; exit 2; }
command -v opencode >/dev/null 2>&1 || { echo "opencode-implement: 'opencode' not on PATH" >&2; exit 127; }
command -v jq >/dev/null 2>&1 || { echo "opencode-implement: 'jq' not on PATH" >&2; exit 127; }
[ -n "$url" ] || url="http://127.0.0.1:${port}"
# A resume is validated against the live server before anything is allocated: a session is
# pinned to the directory it was created in, and a brief for another repo is a new session.
if [ -n "$session" ]; then
  curl -sf "${url}/config" >/dev/null 2>&1 || { echo "opencode-implement: session ${session} cannot be resumed: no server at ${url}" >&2; exit 1; }
  pinned="$(curl -sf "${url}/session/${session}" | jq -r '.directory // empty')"
  [ -n "$pinned" ] || { echo "opencode-implement: session ${session} not found on ${url} — start a new session without -s" >&2; exit 1; }
  [ "$(cd "$pinned" 2>/dev/null && pwd -P)" = "$(cd "$workdir" && pwd -P)" ] || {
    echo "opencode-implement: session ${session} is pinned to ${pinned}, not ${workdir} — start a new session for this directory" >&2
    exit 1
  }
fi
outfile="$(mkdir -p "$(dirname "$outfile")" && cd "$(dirname "$outfile")" && pwd -P)/$(basename "$outfile")"
[ ! -e "$outfile" ] && [ ! -e "$outfile.log" ] || { echo "opencode-implement: $outfile already holds a round; pick a new -o" >&2; exit 2; }
[ -n "$title" ] || title="$(basename "$outfile")"

# One server on the port, started headless if down; it survives this process so the owner can keep
# an `opencode attach` TUI open across rounds. Fence, repos and model are checked before any file
# of the round is written.
"$(dirname "$0")/opencode-preflight" --url "$url" --port "$port" -m "$model" -C "$workdir" "${repos[@]}" \
  --serverlog "${outfile%/*}/opencode-serve-${port}.log" || exit 1

echo $$ > "${outfile}.pid"
echo "opencode-implement: WATCH LIVE ->  opencode attach ${url} --dir ${workdir}   (the TUI lists sessions per --dir; add --session <id> from the .session file to jump straight in)" >&2

claude_docs="$(find "$workdir" -name CLAUDE.md -not -path '*/Library/*' -not -path '*/node_modules/*' 2>/dev/null | sort)"
preamble="Before acting, read ~/.claude/CLAUDE.md, then every CLAUDE.md in this repository (root first, nearer ones apply to their subtree):
$claude_docs
Follow them as user and repository guidance. Skills are available at ~/.claude/skills/<name>/SKILL.md and $workdir/.claude/skills/<name>/SKILL.md; when the task names one or clearly matches one's description, read its SKILL.md completely before acting.

---

"
prompt="$(cat "$promptfile")"
[ -n "$session" ] || prompt="${preamble}${prompt}"
logfile="${outfile}.log"
usagefile="${outfile}.usage"

(cd "$workdir" && pwd -P) > "${outfile}.cwd"
session_args=()
[ -n "$session" ] && session_args=(--session "$session")

# --dir is the only isolation opencode has: a worktree is reviewed as a diff before merging; a real
# checkout is edited in place (the permission block in opencode.jsonc is the fence). opencode-round
# watches for asks, and fails the round unless it finished (see its header).
blocked=""
"$(dirname "$0")/opencode-round" --url "$url" -C "$workdir" --role impl -o "$outfile" "${units[@]}" -- \
  opencode run --attach "$url" --dir "$workdir" --auto \
  -m "$model" --variant "$effort" --title "$title" \
  --format json "${session_args[@]}" \
  "$prompt" || blocked="$(head -1 "$outfile")"
sid="$(cat "${outfile}.session" 2>/dev/null || true)"

ctx="$(jq -r '.context_tokens // empty' "$usagefile" 2>/dev/null)"
compacted="$(jq -r 'if .compacted then "; COMPACTED (\(if .compacted.auto then "auto" else "manual" end), overflow=\(.compacted.overflow)) — context above is post-compaction, history before it is now a summary" else "" end' "$usagefile" 2>/dev/null)"
echo "opencode-implement: $model/$effort ${blocked:+FAILED }done -> $outfile (final msg); diff: git -C $workdir diff; session ${sid:-unknown} pinned to ${workdir}, context ${ctx:-?} tokens (bees: continue < 120k, none ≥ 200k)${compacted}; usage $usagefile; log $logfile; attach: opencode attach ${url} --dir ${workdir} --session ${sid:-<id>}" >&2
[ -z "$blocked" ] || exit 1
