#!/usr/bin/env bash
# What an OpenCode session's latest message is doing, so a stalled model stream can be told apart
# from a long tool call — the run's log and /session/status look the same for both.
#
#   opencode-activity <url> <directory> <session>
#
# Prints `tool` while a tool call is being formed or run (its streamed arguments are not persisted,
# so they cannot be seen changing), otherwise `stream <id> <n>`: the latest message's id and the size
# of its parts, which grows as text and reasoning stream. A `stream` line unchanged for minutes is a
# stall. Exits non-zero when the server cannot answer.
set -uo pipefail
[ $# = 3 ] || { echo "opencode-activity: usage: <url> <directory> <session>" >&2; exit 2; }
curl -sfG -m 10 "$1/session/$3/message" --data-urlencode "directory=$2" --data-urlencode limit=1 2>/dev/null |
  jq -er 'last.parts as $p |
    if any($p[]; .state.status? == "pending" or .state.status? == "running") then "tool" else "stream \(last.info.id) \($p | tojson | length)" end'
