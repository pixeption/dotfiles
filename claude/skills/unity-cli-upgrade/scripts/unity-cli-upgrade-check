#!/usr/bin/env bash
# Read-only report of the installed vs latest Unity CLI and each project's com.unity.pipeline pin.
# Usage: unity-cli-upgrade-check [project-dir...]
# Exit 0 everything is latest, 10 an upgrade is available, 1 a check failed.
set -euo pipefail
export PATH="$HOME/.unity/bin:$PATH"

for tool in unity python3; do
  command -v "$tool" >/dev/null || { echo "$tool not found on PATH: install it, then re-run" >&2; exit 1; }
done

# GameCore first: it owns the packages that declare Pipeline commands, and nono4u/Game compiles them.
(( $# )) || set -- "$HOME/code/nono4u/GameCore" "$HOME/code/nono4u/Game"

cli=$(unity self-update --check --format json) || { echo "unity self-update --check failed" >&2; exit 1; }
versions=$(unity pipeline list-versions --format json) || { echo "unity pipeline list-versions failed" >&2; exit 1; }

python3 - "$cli" "$versions" "$@" <<'PY'
import json, os, sys

cli, pipeline = (json.loads(a)["data"] for a in sys.argv[1:3])
rows = [("cli", "unity", cli["currentVersion"], cli["latestVersion"])]
for project in map(os.path.abspath, sys.argv[3:]):
    manifest = os.path.join(project, "Packages", "manifest.json")
    if not os.path.isfile(manifest):
        sys.exit(f"not a Unity project (no Packages/manifest.json): {project}")
    pin = json.load(open(manifest))["dependencies"].get("com.unity.pipeline", "not installed")
    rows.append(("pipeline", project, pin, pipeline["latest"]))

stale = False
for kind, where, current, latest in rows:
    behind = current != latest
    stale |= behind
    print(f"{kind:9} {where:45} {current:16} latest {latest:16} {'UPGRADE' if behind else 'ok'}")
sys.exit(10 if stale else 0)
PY
